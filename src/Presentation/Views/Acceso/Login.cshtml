@using Presentation.ViewModels.AccesoVM
@model LoginVM

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Compras</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        body {
            background-color: #f8f9fa; 
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            width: 100%;
            max-width: 400px;
            padding: 15px;
            margin: auto;
        }
        .card-header-custom {
            background-color: transparent;
            border-bottom: 0;
            padding-bottom: 0;
        }
    </style>
</head>
<body>

    <main class="login-card animate__animated animate__fadeIn">
        
        <div class="shadow-lg rounded bg-white p-4">
            
            <div class="text-center mb-4">
                <i class="bi bi-cart4 text-primary" style="font-size: 3rem;"></i>
                <h3 class="h3 mb-3 fw-normal text-primary">Bienvenido</h3>
                <p class="text-muted">Sistema de Gestión de Ventas MyL</p>
            </div>

            <form asp-controller="Acceso" asp-action="Login" method="post" id="formLogin">
                
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger d-flex align-items-center" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <div>@ViewBag.Error</div>
                    </div>
                }
                
                @if (!ViewData.ModelState.IsValid)
                {
                     <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                }

                <div class="form-floating mb-3">
                    <input asp-for="Correo" class="form-control" placeholder="nombre@ejemplo.com">
                    <label asp-for="Correo"><i class="bi bi-envelope me-1"></i> Correo Electrónico</label>
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Clave" type="password" class="form-control" placeholder="Contraseña">
                    <label asp-for="Clave"><i class="bi bi-key me-1"></i> Contraseña</label>
                    <span asp-validation-for="Clave" class="text-danger small"></span>
                </div>

                <button class="btn btn-primary w-100 py-2 fs-5" type="submit">
                    Ingresar <i class="bi bi-box-arrow-in-right ms-2"></i>
                </button>

                <div class="mt-4 text-center">
                    <p class="text-muted small">¿Olvidó su contraseña? Contacte al administrador.</p>
                </div>
                <div class="mt-2 text-center">
                    <a asp-controller="Home" asp-action="Index" class="text-decoration-none small text-secondary">
                        <i class="bi bi-arrow-left"></i> Volver al inicio (Público)
                    </a>
                </div>
            </form>
        </div>
        
        <p class="mt-5 mb-3 text-muted text-center small">&copy; @DateTime.Now.Year - Tu Empresa</p>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>