@using src.Presentation.ViewModels.CompraVM
@model GestionarCompraViewModel

@{
    ViewData["Title"] = $"Gestionar Compra #{Model.IdCompra}";
    // Lógica de permisos por estado
    bool puedeEditarProductos = Model.Estado == "PENDIENTE";
    bool puedeEditarObservaciones = Model.Estado == "PENDIENTE" || Model.Estado == "ENVIADA";
    bool mostrarBotonGuardar = puedeEditarProductos || puedeEditarObservaciones;
}

<div class="container py-4">
    @* Encabezado *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold text-dark"><i class="bi bi-pencil-square me-2"></i>Orden #@Model.IdCompra</h2>
            <span class="badge px-3 py-2 fs-6 @(Model.Estado == "PENDIENTE" ? "bg-warning text-dark border border-warning" : "bg-primary-subtle text-primary border border-primary")">
                <i class="bi bi-info-circle me-1"></i>Estado: @Model.Estado
            </span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Volver al Listado
            </a>
            @if (Model.Estado == "ENVIADA")
            {
                <a asp-controller="Factura" asp-action="CrearDesdeCompra" asp-route-id="@Model.IdCompra" class="btn btn-success shadow-sm">
                    <i class="bi bi-receipt-cutoff me-1"></i>Cargar Factura
                </a>
            }
        </div>
    </div>

    @* Mensajes de Error/Éxito *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="GuardarCambios" method="post" id="formGestionar">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdCompra" />
        <input type="hidden" asp-for="IdProveedor" />

        @* Card de Información General *@
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body bg-light rounded shadow-sm">
                <div class="row text-center text-md-start">
                    <div class="col-md-4 border-end">
                        <label class="small text-muted fw-bold">PROVEEDOR</label>
                        <div class="fs-5 text-primary fw-bold">@Model.ProveedorRazonSocial</div>
                    </div>
                    <div class="col-md-4 border-end ps-md-4">
                        <label class="small text-muted fw-bold">FECHA EMISIÓN</label>
                        <div class="fs-5">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="col-md-4 ps-md-4">
                        <label class="small text-muted fw-bold">OPERADOR</label>
                        <div class="fs-5">@Model.UsuarioNombreCompleto</div>
                    </div>
                </div>
                <hr class="my-3">
                <div class="form-group">
                    <label asp-for="Observaciones" class="small text-muted fw-bold mb-1">OBSERVACIONES</label>
                    @if (puedeEditarObservaciones)
                    {
                        <textarea asp-for="Observaciones" class="form-control border-0 shadow-sm" rows="2" placeholder="Notas internas o logísticas..."></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger small"></span>
                    }
                    else
                    {
                        <div class="p-3 bg-white rounded border shadow-sm text-muted italic">
                            @(string.IsNullOrEmpty(Model.Observaciones) ? "Sin notas adicionales." : Model.Observaciones)
                        </div>
                        <input type="hidden" asp-for="Observaciones" />
                    }
                </div>
            </div>
        </div>

        @* Card de Detalles *@
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-secondary">Productos en la Orden</h6>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th class="ps-4">Producto</th>
                            <th class="text-center" style="width: 150px;">Cantidad</th>
                            <th class="text-end" style="width: 180px;">Precio Pactado</th>
                            <th class="text-end pe-4" style="width: 180px;">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Detalles.Count; i++)
                        {
                            <tr>
                                <td class="ps-4">
                                    <input type="hidden" asp-for="Detalles[i].IdDetalleCompra" />
                                    <input type="hidden" asp-for="Detalles[i].IdProducto" />
                                    <input type="hidden" asp-for="Detalles[i].ProductoNombre" />
                                    <div class="fw-bold">@Model.Detalles[i].ProductoNombre</div>
                                </td>
                                <td class="text-center">
                                    @if (puedeEditarProductos)
                                    {
                                        <input asp-for="Detalles[i].Cantidad" type="number" min="1" class="form-control form-control-sm text-center input-cantidad" onchange="calcularTotales()" />
                                    }
                                    else
                                    {
                                        <span class="fw-bold">@Model.Detalles[i].Cantidad</span>
                                        <input type="hidden" asp-for="Detalles[i].Cantidad" />
                                    }
                                </td>
                                <td class="text-end">
                                    @if (puedeEditarProductos)
                                    {
                                        <div class="input-group input-group-sm justify-content-end">
                                            <span class="input-group-text">$</span>
                                            <input asp-for="Detalles[i].PrecioPactado" type="number" step="0.01" class="form-control text-end input-precio" style="max-width: 120px;" onchange="calcularTotales()" />
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">$@Model.Detalles[i].PrecioPactado.ToString("N2")</span>
                                        <input type="hidden" asp-for="Detalles[i].PrecioPactado" />
                                    }
                                </td>
                                <td class="text-end pe-4 fw-bold">
                                    <span class="celda-subtotal text-dark">$@Model.Detalles[i].Subtotal.ToString("N2")</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold border-top">
                        <tr>
                            <td colspan="3" class="text-end py-3 text-muted small">TOTAL DE LA ORDEN</td>
                            <td class="text-end pe-4 py-3 fs-5 text-success" id="celdaTotal">$@Model.TotalEstimado.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (mostrarBotonGuardar)
            {
                <div class="card-footer bg-white border-top-0 py-4 text-end">
                    @if (puedeEditarProductos)
                    {
                        <small class="text-muted d-block mb-3">Límite máximo permitido: $999.999.999,90</small>
                    }
                    <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm">
                        <i class="bi bi-save me-2"></i>Guardar Cambios
                    </button>
                </div>
            }
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calcularTotales() {
            let total = 0;
            document.querySelectorAll('tbody tr').forEach(row => {
                const cantInput = row.querySelector('.input-cantidad');
                const precioInput = row.querySelector('.input-precio');
                
                // Si no hay inputs (caso ENVIADA), leemos el texto o los hidden
                const cant = cantInput ? parseInt(cantInput.value) : parseInt(row.querySelector('input[name*="Cantidad"]').value);
                const precio = precioInput ? parseFloat(precioInput.value) : parseFloat(row.querySelector('input[name*="PrecioPactado"]').value);
                
                if (!isNaN(cant) && !isNaN(precio)) {
                    const subtotal = cant * precio;
                    total += subtotal;
                    row.querySelector('.celda-subtotal').innerText = '$' + subtotal.toLocaleString('es-AR', {minimumFractionDigits:2});
                }
            });
            document.getElementById('celdaTotal').innerText = '$' + total.toLocaleString('es-AR', {minimumFractionDigits:2});
        }
    </script>
}
