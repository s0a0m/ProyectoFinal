@using src.Presentation.ViewModels.CompraVM
@model GestionarCompraViewModel

@{
    ViewData["Title"] = $"Gestionar Compra #{Model.IdCompra}";
    bool esEditable = Model.Estado == "PENDIENTE" || Model.Estado == "ENVIADA";
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-circle me-2"></i>@Html.ValidationSummary(false)
    </div>
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1"><i class="bi bi-pencil-square me-2"></i>Gestionar Compra </h2>
            <span class="badge @(Model.Estado == "PENDIENTE" ? "bg-warning text-dark" : "bg-success") fs-6">
                Estado: @Model.Estado
            </span>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
            @if (Model.Estado == "ENVIADA")
            {
                <button class="btn btn-primary" title="Próximamente" disabled>
                    <i class="bi bi-receipt me-2"></i>Cargar Factura
                </button>
            }
        </div>
    </div>

    <form asp-action="GuardarCambios" method="post" id="formGestionar">
        <input type="hidden" asp-for="IdCompra" />
        
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-circle me-2"></i>Por favor corrija los errores en el formulario.
            </div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <label class="small text-muted fw-bold">PROVEEDOR</label>
                        <div class="fs-5">@Model.ProveedorRazonSocial</div>
                    </div>
                    <div class="col-md-4">
                        <label class="small text-muted fw-bold">FECHA</label>
                        <div class="fs-5">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="col-md-4">
                        <label class="small text-muted fw-bold">SOLICITANTE</label>
                        <div class="fs-5">@Model.UsuarioNombreCompleto</div>
                    </div>
                </div>
                <hr class="my-3">
                <div class="row">
                    <div class="col-12">
                        <label asp-for="Observaciones" class="small text-muted fw-bold mb-1"></label>
                        @if (esEditable)
                        {
                            <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Observaciones" class="text-danger small"></span>
                        }
                        else
                        {
                            <div class="p-2 bg-light rounded">@(string.IsNullOrEmpty(Model.Observaciones) ? "Sin observaciones" : Model.Observaciones)</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow mb-4">
            <div class="card-header bg-light py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 font-weight-bold text-primary">Detalle de Productos</h6>
                @if(esEditable) { <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Edite cantidades o precios</small> }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered mb-0 align-middle" id="tablaDetalles">
                        <thead class="table-light">
                            <tr>
                                <th>Producto</th>
                                <th class="text-center" style="width: 130px;">Cantidad</th>
                                <th class="text-center" style="width: 160px;">Precio Unit.</th>
                                <th class="text-center" style="width: 60px;"></th> <th class="text-end" style="width: 150px;">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Detalles.Count; i++)
                            {
                                // IMPORTANTE: Renderizar fila solo si no está marcada para eliminar, 
                                // O renderizarla pero oculta si hubo error de validación y ya estaba eliminada.
                                var displayStyle = Model.Detalles[i].Eliminar ? "display:none;" : "";
                                
                                <tr class="fila-producto" style="@displayStyle">
                                    <td>
                                        <input type="hidden" asp-for="Detalles[i].IdDetalleCompra" />
                                        <input type="hidden" asp-for="Detalles[i].IdProducto" />
                                        <input type="hidden" asp-for="Detalles[i].ProductoNombre" /> <input type="hidden" asp-for="Detalles[i].Eliminar" class="input-eliminar" />
                                        
                                        <span class="fw-bold">@Model.Detalles[i].ProductoNombre</span>
                                    </td>
                                    
                                    <td class="text-center">
                                        @if (esEditable)
                                        {
                                            <input asp-for="Detalles[i].Cantidad" type="number" 
                                                   class="form-control text-center form-control-sm input-cantidad" 
                                                   min="1" onchange="calcularTotales()" />
                                            <span asp-validation-for="Detalles[i].Cantidad" class="text-danger small d-block"></span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold input-cantidad-static">@Model.Detalles[i].Cantidad</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @if (esEditable)
                                        {
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text">$</span>
                                                <input asp-for="Detalles[i].PrecioPactado" type="number" step="0.01" 
                                                min="0.01" max="99999999" inputmode="decimal" placeholder="0.00"
                                                class="form-control text-end input-precio" 
                                                onchange="calcularTotales()" 
                                                onpaste="handlePastePrecio(event)" />
                                            </div>
                                            <span asp-validation-for="Detalles[i].PrecioPactado" class="text-danger small d-block"></span>
                                        }
                                        else
                                        {
                                            <span class="input-precio-static" data-val="@Model.Detalles[i].PrecioPactado">$@Model.Detalles[i].PrecioPactado.ToString("N2")</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @if(esEditable)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-eliminar" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </td>

                                    <td class="text-end fw-bold text-muted celda-subtotal">
                                        $@Model.Detalles[i].Subtotal.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-active">
                                <td colspan="4" class="text-end fw-bold">TOTAL ESTIMADO</td>
                                <td class="text-end fw-bold fs-5 text-success" id="celdaTotal">
                                    $@Model.TotalEstimado.ToString("N2")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            
            @if (esEditable)
            {
                <div class="card-footer bg-white text-end py-3">
                    <button type="submit" class="btn btn-success px-4 shadow-sm">
                        <i class="bi bi-save me-2"></i>Guardar Cambios
                    </button>
                </div>
            }
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
    document.addEventListener("DOMContentLoaded", function() {

        // ---------- 1) Eliminación de fila ----------
        document.querySelectorAll('.btn-eliminar').forEach(btn => {
            btn.addEventListener('click', function() {
                if (!confirm('¿Eliminar este producto de la orden?')) return;

                const row = this.closest('tr');
                const inputEliminar = row.querySelector('.input-eliminar');
                if (inputEliminar) inputEliminar.value = 'true';

                row.style.display = 'none';
                row.classList.add('eliminado');
                calcularTotales();
            });
        });

        // ---------- 2) Handler para paste en precio ----------
        window.handlePastePrecio = function(e) {
            // Previene pegar texto bruto que rompa el binding
            e.preventDefault();
            const paste = (e.clipboardData || window.clipboardData).getData('text');
            if (!paste) return;
            let normalized = paste.replace(',', '.').replace(/[^\d.]/g, '');
            const parts = normalized.split('.');
            if (parts[0].length > 12) parts[0] = parts[0].slice(0, 12);
            normalized = parts.length > 1 ? parts[0] + '.' + parts[1].slice(0,2) : parts[0];
            const target = e.target;
            if (target && target.tagName === 'INPUT') target.value = normalized;
            // recalcular al pegar
            calcularTotales();
        };

        // Adjuntar handler de paste a inputs existentes (y futuros si hicieras render dinámico)
        document.querySelectorAll('.input-precio').forEach(inp => {
            inp.addEventListener('paste', handlePastePrecio);
            // tambien recalcular al escribir
            inp.addEventListener('input', calcularTotales);
        });

        // Adjuntar listener a inputs de cantidad para recalcular
        document.querySelectorAll('.input-cantidad').forEach(inp => {
            inp.addEventListener('input', calcularTotales);
        });

        // ---------- 3) Cálculo robusto de totales ----------
        window.calcularTotales = function() {
            let totalOrden = 0;

            document.querySelectorAll('.fila-producto').forEach(row => {
                if (row.style.display === 'none' || row.classList.contains('eliminado')) return;

                // Cantidad
                let cantidad = 0;
                const inputCant = row.querySelector('.input-cantidad');
                if (inputCant) {
                    cantidad = parseInt(inputCant.value, 10);
                    if (!Number.isFinite(cantidad) || cantidad < 0) cantidad = 0;
                } else {
                    const spanCant = row.querySelector('.input-cantidad-static');
                    cantidad = parseInt(spanCant?.innerText || '0', 10) || 0;
                }

                // Precio + validación
                const inputPrecio = row.querySelector('.input-precio');
                let precio = 0;
                let precioValido = false;

                if (inputPrecio) {
                    const raw = inputPrecio.value?.toString().trim() || '';
                    const validNumeric = /^[0-9]{1,12}(?:\.[0-9]{1,2})?$/.test(raw);
                    if (validNumeric) {
                        precio = parseFloat(raw);
                        precioValido = Number.isFinite(precio) && precio >= 0;
                    } else {
                        precioValido = false;
                    }
                } else {
                    const spanPrecio = row.querySelector('.input-precio-static');
                    precio = parseFloat(spanPrecio?.getAttribute('data-val') || '0') || 0;
                    precioValido = Number.isFinite(precio) && precio >= 0;
                }

                const celdaSub = row.querySelector('.celda-subtotal');

                if (!precioValido) {
                    // Marcar campo inválido y mostrar feedback inline
                    if (inputPrecio) inputPrecio.classList.add('is-invalid');
                    let feedback = row.querySelector('.precio-feedback');
                    if (!feedback && inputPrecio) {
                        feedback = document.createElement('div');
                        feedback.className = 'small text-danger precio-feedback';
                        feedback.innerText = 'Precio inválido';
                        const cell = inputPrecio.closest('td') || inputPrecio.parentElement;
                        if (cell) cell.appendChild(feedback);
                    }
                    if (celdaSub) celdaSub.innerText = '-';
                    return; // ignorar fila inválida en el total
                } else {
                    // limpiar mensajes si estaba inválido
                    if (inputPrecio) {
                        inputPrecio.classList.remove('is-invalid');
                        const pf = row.querySelector('.precio-feedback');
                        if (pf) pf.remove();
                    }
                }

                const subtotal = cantidad * precio;
                totalOrden += subtotal;

                if (celdaSub) {
                    celdaSub.innerText = '$' + subtotal.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
                }
            });

            const celdaTotal = document.getElementById('celdaTotal');
            if (celdaTotal) {
                celdaTotal.innerText = '$' + totalOrden.toLocaleString('es-AR', {minimumFractionDigits: 2, maximumFractionDigits: 2});
            }
        };

        // Ejecutar cálculo inicial al cargar
        calcularTotales();
    });
    </script>
}
