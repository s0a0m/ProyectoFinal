@using src.Presentation.ViewModels.CompraVM
@using src.Models.Common
@model IEnumerable<ListarCompraViewModel>

@{
    ViewData["Title"] = "Gestión de Compras";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-bag-check-fill me-2"></i>Gestión de Compras</h2>
    </div>

    <ul class="nav nav-pills mb-4 gap-2" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-pendientes" data-filter="PENDIENTE" type="button">
                <i class="bi bi-hourglass-split me-1"></i>Pendientes
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-enviadas" data-filter="ENVIADA" type="button">
                <i class="bi bi-truck me-1"></i>Enviadas
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-completadas" data-filter="HISTORIAL" type="button">
                <i class="bi bi-check-all me-1"></i>Historial
            </button>
        </li>
    </ul>

    @if (TempData["Success"] != null) { <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <div class="card shadow border-0">
        <div class="card-body py-3">
            <div class="row g-2 align-items-center mb-3">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input id="globalSearch" type="text" class="form-control border-start-0 ps-0" placeholder="Buscar por proveedor, usuario, fecha..." />
                    </div>
                </div>
                <div class="col-md-7 text-end">
                    <small class="text-muted">Mostrando: <span id="countVisible">0</span> registros</small>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tablaCompras">
                    <thead class="bg-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Proveedor</th>
                            <th>Usuario</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center" style="width: 150px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            // Data attribute para el filtro de estado
                            <tr data-estado="@item.Estado">
                                <td data-order="@item.Fecha.ToString("yyyyMMddHHmm")">@item.Fecha.ToString("dd/MM/yyyy")</td>
                                
                                <td>@item.ProveedorRazonSocial</td>
                                <td class="small">@item.UsuarioNombre @item.UsuarioApellido</td>
                                <td class="text-end fw-bold">$@item.Total.ToString("N2")</td>
                                <td class="text-center">
                                    @if(item.Estado == "PENDIENTE") { <span class="badge bg-warning text-dark">Pendiente</span> }
                                    else if(item.Estado == "ENVIADA") { <span class="badge bg-primary">Enviada</span> }
                                    else if(item.Estado == "COMPLETADA") { <span class="badge bg-success">Completada</span> }
                                    else if(item.Estado == "CANCELADA") { <span class="badge bg-danger">Cancelada</span> }
                                    else { <span class="badge bg-secondary">@item.Estado</span> }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a asp-action="Gestionar" asp-route-id="@item.IdCompra" class="btn btn-sm btn-outline-primary" title="Ver Detalle">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        @if (item.Estado == "PENDIENTE")
                                        {
                                            <button type="button" class="btn btn-sm btn-success" 
                                                    onclick="confirmarEnvio(@item.IdCompra, '@item.ProveedorRazonSocial')"
                                                    title="Pasar a Enviada">
                                                <i class="bi bi-send"></i>
                                            </button>
                                        }
                                        
                                        @if (item.Estado != "COMPLETADA" && item.Estado != "CANCELADA")
                                        {
                                            <button type="button" class="btn btn-sm btn-danger" 
                                                    onclick="confirmarCancelacion(@item.IdCompra)"
                                                    title="Cancelar">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div id="emptyMessage" class="text-center py-5 text-muted" style="display:none;">
                    No se encontraron compras con los filtros actuales.
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalEnvio" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white"><h5 class="modal-title">Confirmar Envío</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <p>¿Marcar orden <strong>#<span id="lblIdEnvio"></span></strong> como ENVIADA a <strong><span id="lblProvEnvio"></span></strong>?</p>
            </div>
            <div class="modal-footer">
                <form asp-action="MarcarEnviada" method="post">
                    <input type="hidden" name="idCompra" id="hiddenIdEnvio" />
                    <button type="submit" class="btn btn-success">Confirmar</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCancelar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white"><h5 class="modal-title">Cancelar Orden</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <p>¿Está seguro de cancelar la orden <strong>#<span id="lblIdCancel"></span></strong>?</p>
                <form id="formCancel" asp-action="Cancelar" method="post">
                    <input type="hidden" name="idCompra" id="hiddenIdCancel" />
                    <label class="form-label small">Motivo</label>
                    <input type="text" name="motivo" class="form-control" placeholder="Ej: Error de carga..." required />
                    <div class="mt-3 text-end">
                        <button type="submit" class="btn btn-danger">Cancelar Definitivamente</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function() {
            var currentStatusFilter = 'PENDIENTE'; // Valor inicial

            // 1. Extension de busqueda personalizada para DataTable
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    var row = settings.aoData[dataIndex].nTr;
                    var estadoRow = $(row).attr('data-estado') || '';

                    if (currentStatusFilter === 'HISTORIAL') {
                        // Historial muestra Completadas y Canceladas
                        return estadoRow === 'COMPLETADA' || estadoRow === 'CANCELADA';
                    } else {
                        // Filtro exacto (PENDIENTE o ENVIADA)
                        return estadoRow === currentStatusFilter;
                    }
                }
            );

            // 2. Inicializar DataTable
            var table = $('#tablaCompras').DataTable({
                "ordering": true,
                "paging": true,
                "info": false, // Ocultamos info default para usar la nuestra custom
                "searching": true,
                "lengthChange": false,
                "pageLength": 10,
                "order": [[0, 'desc']], // Ordenar por fecha descendente
                "language": { url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json" },
                "dom": 'rt<"d-flex justify-content-center mt-3"p>', // Tabla + Paginación centrada
                "columnDefs": [
                    { "orderable": false, "targets": [5] } // No ordenar acciones
                ],
                "drawCallback": function(settings) {
                    // Actualizar contador
                    var api = this.api();
                    $('#countVisible').text(api.rows({ filter: 'applied' }).count());
                    
                    // Toggle mensaje vacío
                    if (api.rows({ filter: 'applied' }).count() === 0) {
                        $('#emptyMessage').show();
                        $(api.table().node()).hide();
                    } else {
                        $('#emptyMessage').hide();
                        $(api.table().node()).show();
                    }
                }
            });

            // 3. Conectar Input Buscador Global
            $('#globalSearch').on('keyup', function() {
                table.search(this.value).draw();
            });

            // 4. Conectar Tabs de Filtro
            $('.nav-link').on('click', function() {
                // Gestion de clases active
                $('.nav-link').removeClass('active');
                $(this).addClass('active');

                // Actualizar filtro y redibujar
                currentStatusFilter = $(this).data('filter');
                table.draw();
            });

            // Dibujar inicial
            table.draw();
        });

        // Funciones Globales para Modales (fuera del document.ready)
        function confirmarEnvio(id, prov) {
            document.getElementById('lblIdEnvio').innerText = id;
            document.getElementById('lblProvEnvio').innerText = prov;
            document.getElementById('hiddenIdEnvio').value = id;
            new bootstrap.Modal(document.getElementById('modalEnvio')).show();
        }
        function confirmarCancelacion(id) {
            document.getElementById('lblIdCancel').innerText = id;
            document.getElementById('hiddenIdCancel').value = id;
            new bootstrap.Modal(document.getElementById('modalCancelar')).show();
        }
    </script>
}