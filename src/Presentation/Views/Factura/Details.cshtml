@model src.Presentation.ViewModels.FacturaVM.ListarDetalleFacturaViewModel

@{
    ViewData["Title"] = $"Factura {Model.NumeroComprobante}";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
            <div>@TempData["Success"]</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container py-4">
    @* Encabezado con navegación clara *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Facturas</a></li>
                    <li class="breadcrumb-item active">Detalle de Comprobante</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">Factura @Model.NumeroComprobante</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver
            </a>
            @if (Model.Saldo == Model.Total)
            {
                <a asp-action="Edit" asp-route-id="@Model.IdFactura" class="btn btn-warning shadow-sm">
                    <i class="bi bi-pencil me-1"></i> Editar
                </a>
            }
        </div>
    </div>

    <div class="row g-4">
        @* Información Principal *@
        <div class="col-md-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <label class="text-muted small fw-bold text-uppercase mb-2 d-block">Emisor / Proveedor</label>
                            <h4 class="fw-bold text-primary mb-1">@Model.ProveedorNombre</h4>
                            <p class="text-muted mb-0">CUIT: @Model.CuitProveedor</p>
                        </div>
                        <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
                            <label class="text-muted small fw-bold text-uppercase mb-2 d-block">Datos de Registro</label>
                            <p class="mb-1"><strong>Fecha Emisión:</strong> @Model.Fecha.ToString("dd/MM/yyyy")</p>
                            @if (Model.IdCompra.HasValue && Model.IdCompra > 0)
                            {
                                <p class="mb-0">
                                    <strong>Orden Origen:</strong> 
                                    <a asp-controller="Compra" asp-action="Gestionar" asp-route-id="@Model.IdCompra" class="badge bg-primary-subtle text-primary text-decoration-none">
                                        #@Model.IdCompra <i class="bi bi-box-arrow-up-right ms-1"></i>
                                    </a>
                                </p>
                            }
                        </div>
                    </div>

                    @* Tabla de Items *@
                    <div class="table-responsive">
    <table class="table align-middle">
        <thead class="bg-light">
            <tr class="text-muted small text-uppercase">
                <th>Producto</th>
                <th class="text-center">Cant.</th>
                <th class="text-end">Precio Base</th>
                <th class="text-center">Desc. (%)</th> @* COLUMNA NUEVA *@
                <th class="text-end">Precio Neto</th>
                <th class="text-end pe-3">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var it in Model.Items)
            {
                <tr>
                    <td><span class="fw-medium text-dark">@it.ProductoNombre</span></td>
                    <td class="text-center">@it.Cantidad</td>
                    <td class="text-end text-muted small">$@it.PrecioBruto.ToString("N2")</td>
                    <td class="text-center">
                        @if(it.PorcentajeDescuento > 0) {
                            <span class="badge bg-info-subtle text-info border border-info-subtle">@it.PorcentajeDescuento.ToString("N1")%</span>
                        } else {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td class="text-end">$@it.PrecioNeto.ToString("N2")</td>
                    <td class="text-end pe-3 fw-bold">$@((it.PrecioNeto * it.Cantidad).ToString("N2"))</td> @* Cálculo real *@
                </tr>
            }
        </tbody>
    </table>
</div>
                    @* Pie de Factura: Solo Totales *@
                    <div class="row justify-content-end mt-3">
                        <div class="col-md-5 col-lg-4">
                            <div class="d-flex justify-content-between p-2 bg-light rounded">
                                <span class="h5 fw-bold mb-0">TOTAL:</span>
                                <span class="h5 fw-bold text-success mb-0">$@Model.Total.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Sidebar: Información Dinámica (Saldo y Estado) *@
        <div class="col-md-4">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-0">
                    <h6 class="fw-bold text-muted small text-uppercase mb-0">Estado de Cuenta</h6>
                </div>
                <div class="card-body pt-0">
                    <div class="p-3 rounded @(Model.Saldo == 0 ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") mb-3 text-center">
                        <label class="d-block small fw-bold text-uppercase opacity-75">Saldo Pendiente</label>
                        <span class="display-6 fw-bold">$@Model.Saldo.ToString("N2")</span>
                    </div>

                    <ul class="list-group list-group-flush small">
                        <li class="list-group-item d-flex justify-content-between px-0 bg-transparent">
                            <span class="text-muted">Condición de Pago:</span>
                            <span class="fw-bold text-dark">@Model.CondicionPagoDesc</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between px-0 bg-transparent">
                            <span class="text-muted">Fecha de Pago:</span>
                            <span class="fw-bold text-dark">@(Model.FechaPago == DateTime.MinValue ? "Pendiente" : Model.FechaPago.ToString("dd/MM/yyyy"))</span>
                        </li>
                    </ul>

                    <div class="mt-4 d-grid gap-2">
                        <a asp-action="DocumentosAsociados" asp-route-id="@Model.IdFactura" class="btn btn-info text-white shadow-sm">
                            <i class="bi bi-folder2-open me-1"></i> Ver Pagos Relacionados
                        </a>
                    </div>
                </div>
            </div>
            
            <div class="alert alert-light border shadow-sm small">
                <i class="bi bi-info-circle-fill text-primary me-2"></i>
                Esta factura se encuentra <strong>@Model.EstadoPago</strong>.
            </div>
        </div>
    </div>
</div>

<style>
    .breadcrumb-item + .breadcrumb-item::before { content: "›"; }
    .table thead th { border-top: none; font-size: 0.7rem; }
    .list-group-item { border-color: rgba(0,0,0,0.05); }
</style>
