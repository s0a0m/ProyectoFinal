@model src.Presentation.ViewModels.FacturaVM.ListarDetalleFacturaViewModel

@{
    ViewData["Title"] = $"Factura #{Model.IdFactura}";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h4 text-primary">Factura: <span class="fw-bold">@Model.NumeroComprobante</span></h1>
            <small class="text-muted d-block">Proveedor: <strong>@Model.ProveedorNombre</strong></small>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Factura" asp-action="Index" class="btn btn-outline-secondary">← Volver al Listado</a>
            <a asp-action="Edit" asp-route-id="@Model.IdFactura" class="btn btn-warning">Editar</a>


        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="h6 mb-0">Resumen</h3>
                <div class="text-end small text-muted">
                    <div>Emisión: @Model.Fecha.ToString("dd/MM/yyyy")</div>
                    <div>Pago: @(Model.FechaPago == default ? "-" : Model.FechaPago.ToString("dd/MM/yyyy"))</div>
                </div>
            </div>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="fw-bold text-muted small">Proveedor</label>
                    <div class="fs-6 mb-1">@Model.ProveedorNombre</div>
                    <div class="small text-muted">CUIT: @Model.CuitProveedor</div>
                </div>

                <div class="col-md-4">
                    <label class="fw-bold text-muted small">Número</label>
                    <div class="fs-6 mb-1">@Model.NumeroComprobante</div>
                </div>

                <div class="col-md-4 text-end">
                    <label class="fw-bold text-muted small">Total facturado</label>
                    <div class="h5 text-success fw-bold">$@Model.Total.ToString("N2")</div>
                    <div class="small text-muted">@Model.EstadoPago</div>
                </div>
            </div>

            <hr />

            <h5 class="mb-3">Detalle</h5>
            <div class="table-responsive mb-3">
                <table class="table table-sm table-borderless align-middle mb-0">
                    <thead class="table-light small text-muted text-uppercase">
                        <tr>
                            <th>Producto</th>
                            <th class="text-center" style="width:100px;">Cantidad</th>
                            <th class="text-end" style="width:140px;">Precio Bruto</th>
                            <th class="text-end" style="width:120px;">% Desc.</th>
                            <th class="text-end" style="width:140px;">Precio Neto</th>
                            <th class="text-end" style="width:160px;">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in Model.Items)
                        {
                            <tr>
                                <td>@it.ProductoNombre</td>
                                <td class="text-center">@it.Cantidad</td>
                                <td class="text-end">$@it.PrecioBruto.ToString("N2")</td>
                                <td class="text-end">@it.PorcentajeDescuento.ToString("N2") %</td>
                                <td class="text-end">$@it.PrecioNeto.ToString("N2")</td>
                                <td class="text-end">$@it.Subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-active">
                            <td colspan="5" class="text-end fw-bold">TOTAL</td>
                            <td class="text-end fw-bold">$@Model.Total.ToString("N2")</td>
                        </tr>
                        <tr class="table-active">
                            <td colspan="5" class="text-end fw-bold">SALDO</td>
                            <td class="text-end fw-bold">$@Model.Saldo.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.CondicionPagoDesc))
            {
                <div class="row mt-3">
                    <div class="col-12">
                        <label class="fw-bold text-muted small">Condición de Pago</label>
                        <p class="mb-0">@Model.CondicionPagoDesc</p>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<style>
    .card { border-radius: .45rem; }
    .table-light { border-bottom: 1px solid #eef1f4; }
</style>
