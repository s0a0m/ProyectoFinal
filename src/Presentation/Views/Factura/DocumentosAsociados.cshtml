@model src.Presentation.ViewModels.FacturaVM.DocumentosRelacionadosViewModel

@{
    ViewData["Title"] = "Documentos Asociados";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h4 text-primary"><i class="bi bi-folder2-open me-2"></i>Documentos Asociados</h2>
            <div class="text-muted">
                Factura: <strong>@Model.NumeroFactura</strong> | Proveedor: <strong>@Model.Proveedor</strong>
            </div>
        </div>
        <a href="@(Context.Request.Headers["Referer"].ToString() ?? Url.Action("Index"))"
   class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>

    <div class="row">
        
        <div class="col-md-12 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    <h6 class="m-0 fw-bold text-secondary"><i class="bi bi-file-text me-2"></i>Notas de Crédito y Débito</h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.Comprobantes.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-muted text-uppercase">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Tipo</th>
                                        <th>Número</th>
                                        <th>Motivo</th>
                                        <th class="text-end">Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Comprobantes)
                                    {
                                        <tr>
                                            <td>@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (item.Tipo == "Nota de Crédito")
                                                {
                                                    <span class="badge bg-danger bg-opacity-10 text-danger">NC</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary bg-opacity-10 text-primary">ND</span>
                                                }
                                            </td>
                                            <td class="font-monospace">@item.Numero</td>
                                            <td class="small">@item.Motivo</td>
                                            <td class="text-end fw-bold">$@item.Total.ToString("N2")</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-link text-muted"><i class="bi bi-eye"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            No hay notas de crédito o débito asociadas.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    <h6 class="m-0 fw-bold text-secondary"><i class="bi bi-cash-stack me-2"></i>Órdenes de Pago</h6>
                </div>
                <div class="card-body p-0">
                    @if (Model.OrdenesPago.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-muted text-uppercase">
                                    <tr>
                                        <th>Fecha Pago</th>
                                        <th>Numero</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-end" title="Monto aplicado a esta factura">Aplicado</th>
                                        <th class="text-end" title="Monto total de la orden de pago">Total OP</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var op in Model.OrdenesPago)
                                    {
                                        <tr>
                                            <td>
                                                @(op.FechaPago.HasValue ? op.FechaPago.Value.ToString("dd/MM/yyyy") : "-")
                                            </td>
                                            
                                            <td class="font-monospace fw-bold text-dark">@op.Numero</td>
                                            
                                            <td class="text-center">
                                                @if (op.Enviada)
                                                {
                                                    <span class="badge bg-success rounded-pill">Enviada</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary rounded-pill">Borrador</span>
                                                }
                                            </td>

                                            <td class="text-end fw-bold text-primary">
                                                $@op.MontoAplicado.ToString("N2")
                                            </td>

                                            <td class="text-end text-muted small">
                                                $@op.TotalOrden.ToString("N2")
                                            </td>

                                            <td class="text-end">
                                                <button type="button" 
                                                class="btn btn-outline-secondary" 
                                                title="Ver Detalle"
                                                onclick="verDetalleOrden(@op.IdOrdenPago)">
                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                </button>
                                                    
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">
                            Esta factura aún no tiene pagos registrados.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetalleOrden" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="contenidoModalOrden">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
<script>
    function verDetalleOrden(idOrden) {

            var myModal = new bootstrap.Modal(document.getElementById('modalDetalleOrden'));
            myModal.show();

         
            $.get('/OrdenesPago/ObtenerDetalleModal/' + idOrden)
                .done(function (data) {
                    // Reemplazar el contenido del modal con la vista parcial
                    $('#contenidoModalOrden').html(data);
                })
                .fail(function () {
                    $('#contenidoModalOrden').html(
                        '<div class="modal-header"><h5 class="modal-title">Error</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>' +
                        '<div class="modal-body text-danger">No se pudo cargar el detalle de la orden.</div>'
                    );
                });
            
            document.getElementById('modalDetalleOrden').addEventListener('hidden.bs.modal', function () {
                $('#contenidoModalOrden').html('<div class="modal-body text-center py-5"><div class="spinner-border text-primary"></div></div>');
            });
        }
</script>
}
