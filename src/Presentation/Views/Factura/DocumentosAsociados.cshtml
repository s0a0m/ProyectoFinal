@model src.Presentation.ViewModels.FacturaVM.DocumentosRelacionadosViewModel

@{
    ViewData["Title"] = "Documentos Asociados";
}

<div class="container py-4">
    @* Encabezado con Info de Factura y Acciones Rápidas *@
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Facturas</a></li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.IdFactura">#@Model.NumeroFactura</a></li>
                    <li class="breadcrumb-item active">Documentos Asociados</li>
                </ol>
            </nav>
            <h2 class="h4 fw-bold text-dark mb-0">Gestión de Documentos Relacionados</h2>
            <p class="text-muted small mb-0">Proveedor: <span class="fw-bold text-primary">@Model.Proveedor</span></p>
        </div>
        <div class="d-flex gap-2">
             <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
            @* BOTONES DE ACCIÓN DIRECTA *@
            <div class="dropdown">
                <button class="btn btn-primary dropdown-toggle shadow-sm" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-plus-lg me-1"></i> Nueva Gestión
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                    <li><a class="dropdown-item" href="#"><i class="bi bi-cash me-2"></i>Registrar Pago</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="#"><i class="bi bi-file-earmark-minus me-2"></i>Nota de Crédito</a></li>
                    <li><a class="dropdown-item text-primary" href="#"><i class="bi bi-file-earmark-plus me-2"></i>Nota de Débito</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @* Sección: Comprobantes (NC/ND) *@
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-dark"><i class="bi bi-file-earmark-text text-muted me-2"></i>Ajustes de Cuenta (NC / ND)</h6>
                    <span class="badge bg-light text-dark border">@Model.Comprobantes.Count comprobantes</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.Comprobantes.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-muted text-uppercase">
                                    <tr>
                                        <th class="ps-3">Fecha</th>
                                        <th>Tipo</th>
                                        <th>Número</th>
                                        <th>Motivo</th>
                                        <th class="text-end pe-3">Monto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Comprobantes)
                                    {
                                        <tr>
                                            <td class="ps-3">@item.FechaEmision.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (item.Tipo.Contains("Crédito"))
                                                {
                                                    <span class="badge bg-danger-subtle text-danger px-2 border border-danger-subtle">NC</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary-subtle text-primary px-2 border border-primary-subtle">ND</span>
                                                }
                                            </td>
                                            <td class="font-monospace text-dark">@item.Numero</td>
                                            <td class="small text-muted">@item.Motivo</td>
                                            <td class="text-end pe-3 fw-bold @(item.Tipo.Contains("Crédito") ? "text-danger" : "text-primary")">
                                                @(item.Tipo.Contains("Crédito") ? "-" : "+")$@item.Total.ToString("N2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted small">
                            <i class="bi bi-info-circle d-block mb-2 display-6 opacity-25"></i>
                            No hay notas de crédito o débito asociadas a esta factura.
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Sección: Órdenes de Pago *@
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold text-dark"><i class="bi bi-cash-stack text-muted me-2"></i>Historial de Pagos Aplicados</h6>
                    <span class="badge bg-light text-dark border">@Model.OrdenesPago.Count pagos</span>
                </div>
                <div class="card-body p-0">
                    @if (Model.OrdenesPago.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-muted text-uppercase">
                                    <tr>
                                        <th class="ps-3">Fecha</th>
                                        <th>Nº Orden</th>
                                        <th class="text-center">Estado</th>
                                        <th class="text-end">Total OP</th>
                                        <th class="text-end pe-3">Monto Aplicado</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var op in Model.OrdenesPago)
                                    {
                                        <tr>
                                            <td class="ps-3">@(op.FechaPago.HasValue ? op.FechaPago.Value.ToString("dd/MM/yyyy") : "Pendiente")</td>
                                            <td class="font-monospace fw-bold">@op.Numero</td>
                                            <td class="text-center">
                                                @if (op.Enviada)
                                                {
                                                    <span class="badge bg-success-subtle text-success rounded-pill px-3">Enviada</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3">Borrador</span>
                                                }
                                            </td>
                                            <td class="text-end text-muted small">$@op.TotalOrden.ToString("N2")</td>
                                            <td class="text-end pe-3 fw-bold text-success">$@op.MontoAplicado.ToString("N2")</td>
                                            <td class="text-end pe-3">
                                                <button onclick="verDetalleOrden(@op.IdOrdenPago)" class="btn btn-sm btn-light border">
                                                    <i class="bi bi-search"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted small">
                            <i class="bi bi-wallet2 d-block mb-2 display-6 opacity-25"></i>
                            Esta factura aún no registra pagos.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalDetalleOrden" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="contenidoModalOrden">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
<script>
    function verDetalleOrden(idOrden) {

            var myModal = new bootstrap.Modal(document.getElementById('modalDetalleOrden'));
            myModal.show();

         
            $.get('/OrdenesPago/ObtenerDetalleModal/' + idOrden)
                .done(function (data) {
                    // Reemplazar el contenido del modal con la vista parcial
                    $('#contenidoModalOrden').html(data);
                })
                .fail(function () {
                    $('#contenidoModalOrden').html(
                        '<div class="modal-header"><h5 class="modal-title">Error</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>' +
                        '<div class="modal-body text-danger">No se pudo cargar el detalle de la orden.</div>'
                    );
                });
            
            document.getElementById('modalDetalleOrden').addEventListener('hidden.bs.modal', function () {
                $('#contenidoModalOrden').html('<div class="modal-body text-center py-5"><div class="spinner-border text-primary"></div></div>');
            });
        }
</script>
}
