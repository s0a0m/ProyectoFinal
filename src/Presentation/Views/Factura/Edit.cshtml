@using src.Presentation.ViewModels.FacturaVM
@model ActualizarFacturaViewModel

@{
    ViewData["Title"] = "Editar Factura";
}

<div class="container py-4">
    <form asp-action="Edit" method="post" id="formFactura">
        @* Campos ocultos para mantener el estado en el POST *@
        <input type="hidden" asp-for="IdFactura" />
        <input type="hidden" asp-for="IdCompra" />
        <input type="hidden" asp-for="IdProveedor" />
        <input type="hidden" asp-for="RazonSocial" />

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="h3 text-warning fw-bold"><i class="bi bi-pencil-square me-2"></i>Editar Factura</h2>
                <p class="text-muted small">Proveedor: <strong>@Model.RazonSocial</strong> | Comprobante #@Model.NumeroFactura</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.IdFactura" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg me-1"></i> Cancelar
            </a>
        </div>

        @* Mensajes de Error de Lógica (Servidor/Duplicados) *@
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4">
                <div asp-validation-summary="ModelOnly" class="small mt-1"></div>
            </div>
        }

        <div class="row g-4">
            @* LADO IZQUIERDO: Cabecera e Items *@
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light py-3">
                        <h6 class="m-0 fw-bold text-secondary text-uppercase small">Datos del Comprobante</h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NumeroFactura" class="form-label small fw-bold text-muted">NÚMERO DE FACTURA</label>
                                <input asp-for="NumeroFactura" class="form-control" />
                                <span asp-validation-for="NumeroFactura" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FechaEmision" class="form-label small fw-bold text-muted">FECHA EMISIÓN</label>
                                <input asp-for="FechaEmision" type="date" class="form-control" />
                                <span asp-validation-for="FechaEmision" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light py-3">
                        <h6 class="m-0 fw-bold text-secondary text-uppercase small">Items de la Factura</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="bg-light small text-uppercase text-muted">
                                <tr>
                                    <th class="ps-4">Producto</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-end">Precio Base</th>
                                    <th class="text-center" style="width: 140px;">Desc. (%)</th>
                                    <th class="text-end pe-4">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Detalles.Count; i++)
                                {
                                    <tr class="fila-producto" 
                                        data-cantidad="@Model.Detalles[i].Cantidad" 
                                        data-bruto="@Model.Detalles[i].PrecioBruto.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)">
                                        
                                        <input type="hidden" asp-for="Detalles[i].IdProducto" />
                                        @* Importante: mantenemos estos hiddens para que el ModelBinder no pierda los datos al re-mostrar la vista por error *@
                                        <input type="hidden" asp-for="Detalles[i].NombreProducto" />
                                        <input type="hidden" asp-for="Detalles[i].Cantidad" />
                                        <input type="hidden" asp-for="Detalles[i].PrecioBruto" />

                                        <td class="ps-4">
                                            <div class="fw-bold text-dark">@Model.Detalles[i].NombreProducto</div>
                                        </td>
                                        <td class="text-center">@Model.Detalles[i].Cantidad</td>
                                        <td class="text-end">$@Model.Detalles[i].PrecioBruto.ToString("N2")</td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input asp-for="Detalles[i].PorcentajeDescuento" type="number" 
                                                       class="form-control text-center input-desc" step="0.01" />
                                                <span class="input-group-text">%</span>
                                            </div>
                                            <span asp-validation-for="Detalles[i].PorcentajeDescuento" class="text-danger" style="font-size: 0.7rem;"></span>
                                        </td>
                                        <td class="text-end pe-4 fw-bold text-success span-subtotal">$0.00</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* LADO DERECHO: Pago y Total *@
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-light py-3">
                        <h6 class="m-0 fw-bold text-secondary text-uppercase small">Financiación</h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="TipoCondicion" class="form-label small fw-bold text-muted">TIPO</label>
                            <select asp-for="TipoCondicion" class="form-select" id="selectTipoPago">
                                <option value="Contado">Contado</option>
                                <option value="Cuota">En Cuotas</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DiasPago" class="form-label small fw-bold text-muted">DÍAS VENCIMIENTO</label>
                            <div class="input-group">
                                <input asp-for="DiasPago" type="number" class="form-control" min="0" />
                                <span class="input-group-text small">días</span>
                            </div>
                        </div>
                        <div class="seccion-cuota" style="display:none;">
                            <div class="mb-3">
                                <label asp-for="CantidadCuotas" class="form-label small fw-bold text-muted">CANT. CUOTAS</label>
                                <input asp-for="CantidadCuotas" type="number" class="form-control" min="1" />
                            </div>
                            <div class="mb-0">
                                <label asp-for="InteresPorcentual" class="form-label small fw-bold text-muted">INTERÉS (%)</label>
                                <input asp-for="InteresPorcentual" type="number" class="form-control" step="0.01" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 bg-light mb-4">
                    <div class="card-body p-4 text-center">
                        <label class="small text-uppercase fw-bold text-muted d-block mb-1">Total Actualizado</label>
                        <h2 class="display-6 fw-bold text-success mb-4" id="totalGeneral">$0,00</h2>
                        
                        <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold shadow-sm">
                            <i class="bi bi-save me-2"></i>Guardar Cambios
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    document.addEventListener("DOMContentLoaded", function() {
        const totalGeneral = document.getElementById('totalGeneral');
        const filas = document.querySelectorAll('.fila-producto');
        const selectTipo = document.getElementById('selectTipoPago');
        const sectionsCuota = document.querySelectorAll('.seccion-cuota');

        // 1. Lógica de visibilidad de cuotas
        function toggleCuotaFields() {
            const esCuota = selectTipo.value === 'Cuota';
            sectionsCuota.forEach(el => el.style.display = esCuota ? 'block' : 'none');
        }

        // 2. Lógica de cálculos
        function recalcular() {
            let total = 0;
            filas.forEach(row => {
                const cant = parseFloat(row.dataset.cantidad) || 0;
                const bruto = parseFloat(row.dataset.bruto) || 0;
                const desc = parseFloat(row.querySelector('.input-desc').value) || 0;

                const neto = bruto - (bruto * (desc / 100));
                const sub = neto * cant;
                total += sub;

                row.querySelector('.span-subtotal').innerText = '$' + sub.toLocaleString('es-AR', { minimumFractionDigits: 2 });
            });
            totalGeneral.innerText = '$' + total.toLocaleString('es-AR', { minimumFractionDigits: 2 });
        }

        // Eventos
        if (selectTipo) {
            selectTipo.addEventListener('change', toggleCuotaFields);
            toggleCuotaFields();
        }

        document.querySelectorAll('.input-desc').forEach(inp => {
            inp.addEventListener('input', recalcular);
        });

        recalcular(); 
    });
    </script>
}
