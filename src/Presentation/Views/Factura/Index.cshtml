@using src.Presentation.ViewModels.FacturaVM
@model IEnumerable<ListarFacturaViewModel>

@{
    ViewData["Title"] = "Facturas";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="h4 text-primary"><i class="bi bi-receipt me-2"></i>Facturas</h2>
            <small class="text-muted d-block">Listado de facturas registradas en el sistema</small>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Compra"
            asp-action="Index"
            asp-route-estado="ENVIADA"
            class="btn btn-primary shadow-sm">
                <i class="bi bi-file-earmark-plus me-1"></i>
                Cargar Factura
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null )
    {
        var msg = TempData["Error"];
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@msg
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body py-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input id="filterProveedor" type="text" class="form-control" placeholder="Filtrar por proveedor..." />
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="btn-group" role="group" aria-label="Filtrar pagadas">
                        <button class="btn btn-outline-secondary btn-sm active" id="btnFiltroTodos" type="button">Todos</button>
                        <button class="btn btn-outline-secondary btn-sm" id="btnFiltroPagadas" type="button">Pagadas</button>
                        <button class="btn btn-outline-secondary btn-sm" id="btnFiltroNoPagadas" type="button">No pagadas</button>
                    </div>
                </div>

                <div class="col-md-3 text-end">
                    <small class="text-muted">Total: <span id="countVisible">0</span> / @Model.Count()</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tablaFacturas">
                    <thead class="table-light text-uppercase small text-muted">
                        <tr>
                            <th>Nº Factura</th>
                            <th>Proveedor</th>
                            <th>Fecha</th>
                            <th class="text-end">Total</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center" style="width:160px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model)
                        {
                            // data attributes usados por JS para filtrar
                            var proveedorAttr = (f.Proveedor ?? string.Empty).ToLowerInvariant();
                            var estaPagada = (f.EstadoPago ?? string.Empty).ToLowerInvariant().Contains("pag") ? "true" : "false";

                            <tr class="fila-factura" data-proveedor="@proveedorAttr" data-pagada="@estaPagada">
                                <td class="fw-bold">@f.NumeroComprobante</td>
                                <td>@f.Proveedor</td>
                                <td>@f.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-bold">$@f.Total.ToString("N2")</td>
                                <td class="text-center">
                                    @if (f.EstadoPago?.ToLowerInvariant().Contains("pag") == true)
                                    {
                                        <span class="badge bg-success">Pagada</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Sin pagar</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@f.IdFactura" class="btn btn-sm btn-outline-primary" title="Ver">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@f.IdFactura" class="btn btn-sm btn-outline-warning" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div id="emptyMessage" class="text-center py-5 text-muted" style="display:none;">
                    No se encontraron facturas con esos filtros.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            // 1. Configuración de Filtros Personalizados para DataTable
            // Esto reemplaza tu lógica manual de 'display: none' para que funcione con paginación
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    // Obtenemos la fila DOM real para leer los data-attributes
                    var row = settings.aoData[dataIndex].nTr;
                    var provAttr = $(row).attr('data-proveedor') || '';
                    var pagadaAttr = $(row).attr('data-pagada') === 'true';

                    // Lógica del Input de Proveedor
                    var term = $('#filterProveedor').val().toLowerCase();
                    if (term && provAttr.indexOf(term) === -1) {
                        return false;
                    }

                    // Lógica de los Botones de Estado
                    var filterPagadas = $('#btnGroupEstado .active').data('filter'); // Ver nota abajo sobre HTML
                    
                    if (filterPagadas === 'pagadas' && !pagadaAttr) return false;
                    if (filterPagadas === 'nopagadas' && pagadaAttr) return false;

                    return true;
                }
            );

            // 2. Inicialización del DataTable
            var table = $('#tablaFacturas').DataTable({
                "ordering": true,
                "paging": true,
                "info": true,
                "searching": true,      // Necesario true internamente para que funcionen nuestros filtros custom
                "pageLength": 10,       // Cantidad de items por página
                "lengthChange": false,  // Ocultar selector de "mostrar 10/25/50"
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
                },
                // Configuración DOM para ocultar el buscador nativo ('f') pero dejar tabla ('t'), info ('i') y paginación ('p')
                "dom": 'rt<"d-flex justify-content-between mt-3"ip>',
                "columnDefs": [
                    { "orderable": false, "targets": [5] } // Desactivar ordenamiento en columna Acciones
                ]
            });

            // 3. Eventos para redibujar la tabla (dispara el filtro de arriba)
            
            // Input Proveedor
            $('#filterProveedor').on('keyup', function () {
                table.draw();
                updateCounter();
            });

            // Botones de filtro (necesitamos ligeros cambios en tu HTML o selectores JS)
            $('#btnFiltroTodos').on('click', function() {
                toggleActive(this, 'todos');
            });
            $('#btnFiltroPagadas').on('click', function() {
                toggleActive(this, 'pagadas');
            });
            $('#btnFiltroNoPagadas').on('click', function() {
                toggleActive(this, 'nopagadas');
            });

            // Variable auxiliar para guardar el estado actual del filtro de botones
            var currentFilterState = 'todos';

            function toggleActive(btn, state) {
                // Actualizar clases visuales
                $('#btnFiltroTodos, #btnFiltroPagadas, #btnFiltroNoPagadas').removeClass('active');
                $(btn).addClass('active');
                
                // Actualizar estado y redibujar
                currentFilterState = state;
                table.draw();
                updateCounter();
            }

            // Sobreescribimos la lógica del filtro para usar la variable currentFilterState
            // (Reemplazando la lectura del DOM que puse en el paso 1 para simplificar)
            $.fn.dataTable.ext.search.pop(); // Quitamos la anterior si existiera y ponemos la definitiva
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    var row = settings.aoData[dataIndex].nTr;
                    var provAttr = $(row).attr('data-proveedor') || '';
                    var pagadaAttr = $(row).attr('data-pagada') === 'true';

                    // Filtro Texto
                    var term = $('#filterProveedor').val().toLowerCase();
                    if (term && provAttr.indexOf(term) === -1) return false;

                    // Filtro Botones
                    if (currentFilterState === 'pagadas' && !pagadaAttr) return false;
                    if (currentFilterState === 'nopagadas' && pagadaAttr) return false;

                    return true;
                }
            );

            // Contador de visibles
            function updateCounter() {
                var info = table.page.info();
                // Mostramos el total de registros después de filtrar (recordsDisplay)
                $('#countVisible').text(info.recordsDisplay);
                
                // Mostrar mensaje de vacío si corresponde
                if (info.recordsDisplay === 0) {
                    $('#emptyMessage').show();
                    $('#tablaFacturas').hide(); // Ocultamos tabla vacía para que se vea el mensaje limpio
                } else {
                    $('#emptyMessage').hide();
                    $('#tablaFacturas').show();
                }
            }

            // Inicializar contador
            updateCounter();
        });
    </script>
}