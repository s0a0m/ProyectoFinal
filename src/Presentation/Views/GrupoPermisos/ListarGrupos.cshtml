@using src.Models.Domain
@model IEnumerable<GrupoPermisos>

@{
    ViewData["Title"] = "Grupos de Permisos";
}

@if (TempData["realizado"] != null)
{
    <section class="container py-3">
        <div class="alert alert-success w-75 mx-auto alert-dismissible fade show" role="alert">
            <p class="text-center mb-0">@TempData["realizado"]</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </section>
}

<div class="container mt-4">
    <h1 class="text-center mb-4">@ViewData["Title"]</h1>

    <div class="d-flex justify-content-end mb-3">
        <a asp-controller="GrupoPermisos" asp-action="CrearGrupo" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Añadir Grupo
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No hay grupos de permisos registrados.
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">Descripción</th>
                        <th scope="col" class="text-center">Operaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var grupo in Model)
                    {
                        <tr>
                            <td>@grupo.Nombre</td>
                            <td>@grupo.Descripcion</td>
                            
                            <td class="text-center">
                                <a asp-controller="GrupoPermisos" 
                                   asp-action="VerGrupo" 
                                   asp-route-id="@grupo.IdGrupoPermiso" 
                                   class="btn btn-info btn-sm me-1" 
                                   title="Ver Detalle">
                                   <i class="bi bi-eye"></i>
                                </a>
                                <a asp-controller="GrupoPermisos" 
                                   asp-action="ActualizarGrupo" 
                                   asp-route-id="@grupo.IdGrupoPermiso" 
                                   class="btn btn-warning btn-sm me-1" 
                                   title="Actualizar">
                                   <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-controller="GrupoPermisos" 
                                   asp-action="EliminarGrupo" 
                                   asp-route-id="@grupo.IdGrupoPermiso" 
                                   class="btn btn-danger btn-sm" 
                                   title="Eliminar" 
                                   onclick="return confirm('¿Está seguro que desea eliminar este grupo?');">
                                   <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}