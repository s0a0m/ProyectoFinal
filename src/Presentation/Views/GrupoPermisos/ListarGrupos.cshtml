@using src.Models.Domain
@model IEnumerable<GrupoPermisos>

@{
    ViewData["Title"] = "Grupos de Permisos";
}

@* Mensajes: mantengo tu TempData["realizado"] por compatibilidad, y sumo checks comunes *@
@if (TempData["realizado"] != null)
{
    <div class="container py-3">
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["realizado"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="container py-3">
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="container py-3">
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0 text-gray-800">@ViewData["Title"]</h1>

        <div>
            @* Mantenemos la acción original (no cambié la lógica) *@
            <a asp-controller="GrupoPermisos" asp-action="CrearGrupo" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-2"></i>Añadir Grupo
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center p-5 shadow-sm">
            <i class="bi bi-people display-4 mb-3 d-block text-muted"></i>
            <p class="h5 text-muted mb-1">No hay grupos de permisos registrados.</p>
            <p class="small text-muted mb-0">Crea un grupo para organizar permisos y facilitar roles dentro del sistema.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th style="width: 48px;"></th>
                                <th>Nombre</th>
                                <th class="text-muted">Descripción</th>
                                <th class="text-center" style="width: 170px;">Operaciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var grupo in Model)
                            {
                                <tr class="fw-bold text-dark">
                                    <td class="text-center pe-0">
                                        @* simple affordance visual - no modifica lógica *@
                                        <button class="btn btn-sm btn-outline-secondary rounded-circle" type="button" 
                                                data-bs-toggle="collapse" data-bs-target="#collapseGrupo_@grupo.IdGrupoPermiso"
                                                aria-expanded="false" aria-controls="collapseGrupo_@grupo.IdGrupoPermiso" title="Ver descripción">
                                            <i class="bi bi-chevron-down"></i>
                                        </button>
                                    </td>

                                    <td>
                                        <i class="bi bi-people-fill me-2 text-primary"></i>
                                        @grupo.Nombre
                                    </td>

                                    <td class="text-muted small">
                                        @* mostramos un snippet (estético) pero la descripción completa aparece al desplegar *@
                                        @{
                                            var txt = string.IsNullOrWhiteSpace(grupo.Descripcion) ? "-" : grupo.Descripcion;
                                            var snippet = txt.Length > 80 ? txt.Substring(0, 80) + "…" : txt;
                                        }
                                        @snippet
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group" aria-label="Acciones grupo">
                                            <a asp-controller="GrupoPermisos" 
                                               asp-action="VerGrupo" 
                                               asp-route-id="@grupo.IdGrupoPermiso" 
                                               class="btn btn-sm btn-outline-info" 
                                               title="Ver Detalle">
                                               <i class="bi bi-eye"></i>
                                            </a>

                                            <a asp-controller="GrupoPermisos" 
                                               asp-action="ActualizarGrupo" 
                                               asp-route-id="@grupo.IdGrupoPermiso" 
                                               class="btn btn-sm btn-outline-warning" 
                                               title="Actualizar">
                                               <i class="bi bi-pencil-square"></i>
                                            </a>

                                            <form asp-controller="GrupoPermisos" asp-action="EliminarGrupo" method="post" class="d-inline"
                                                  onsubmit="return confirm('¿Está seguro que desea eliminar este grupo?');">
                                                <input type="hidden" name="id" value="@grupo.IdGrupoPermiso" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>

                                <tr class="p-0">
                                    <td colspan="4" class="p-0 border-0">
                                        <div class="collapse bg-light border-bottom" id="collapseGrupo_@grupo.IdGrupoPermiso">
                                            <div class="p-3 small text-muted">
                                                <strong class="text-dark">Descripción completa:</strong>
                                                <div class="mt-1">@(!string.IsNullOrWhiteSpace(grupo.Descripcion) ? grupo.Descripcion : "<em>Sin descripción.</em>")</div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    <style>
        /* Estética inspirada en módulos recientes: tarjetas limpias, sombras suaves, tipografía compacta */
        .card { border-radius: .45rem; }
        .table > thead > tr > th { border-bottom: 1px solid rgba(0,0,0,0.05); }
        .table-hover tbody tr:hover { background-color: rgba(13,110,253,0.03); }
        .btn-outline-info, .btn-outline-warning, .btn-outline-danger { min-width: 42px; display: inline-flex; align-items: center; justify-content: center; }
        .btn-outline-info i, .btn-outline-warning i, .btn-outline-danger i { font-size: 1rem; }

        /* Collapse visual tweak */
        .collapse { transition: all .25s ease-in-out; }
        .collapse.bg-light { background-color: #fbfcfd; }
        .bi-chevron-down { transition: transform .25s ease; }

        /* small screens: compact table */
        @@media (max-width: 767px) {
            .table thead { display: none; }
            .table tbody tr { display: block; margin-bottom: .75rem; border: 1px solid #e9ecef; border-radius:.4rem; padding: .5rem; }
            .table tbody td { display: block; width: 100%; }
            .table tbody td.text-center { text-align: right; }
        }
    </style>
}

@section Scripts {
    <script>
        // pequeño detalle visual: rota el chevron cuando el collapse está abierto
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll('[data-bs-toggle="collapse"]').forEach(btn => {
                const targetSelector = btn.getAttribute('data-bs-target');
                if (!targetSelector) return;
                const targetEl = document.querySelector(targetSelector);
                if (!targetEl) return;

                targetEl.addEventListener('show.bs.collapse', function () {
                    btn.querySelector('.bi-chevron-down')?.classList.add('rotated');
                });
                targetEl.addEventListener('hide.bs.collapse', function () {
                    btn.querySelector('.bi-chevron-down')?.classList.remove('rotated');
                });
            });
        });
    </script>

    <style>
        /* rotación suave del icono */
        .bi-chevron-down.rotated { transform: rotate(180deg); }
    </style>
}
