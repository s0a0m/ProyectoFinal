@using src.Models.Domain
@model GrupoPermisos

@{
    ViewData["Title"] = "Detalle del Grupo";
}

<div class="container mt-5">
    <div class="row">

        <div class="col-lg-4 mb-4 mb-lg-0">
            <div class="card shadow-sm">
                <div class="card-body text-center p-4">
                    <i class="bi bi-collection display-1 text-primary mb-3"></i>

                    <h3 class="card-title mb-2">@Model.Nombre</h3>
                    
                    @if (!string.IsNullOrEmpty(Model.Descripcion))
                    {
                        <p class="text-muted">@Model.Descripcion</p>
                    }
                    else
                    {
                         <p class="text-muted fst-italic">Sin descripción.</p>
                    }
                </div>
                <div class="card-footer bg-light p-3">
                    <a asp-controller="GrupoPermisos" 
                       asp-action="ActualizarGrupo" 
                       asp-route-id="@Model.IdGrupoPermiso" 
                       class="btn btn-primary w-100 mb-2">
                        <i class="bi bi-pencil-square me-1"></i> Editar Grupo
                    </a>
                    <a asp-controller="GrupoPermisos" 
                       asp-action="ListarGrupos" 
                       class="btn btn-outline-secondary w-100">
                        <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Permisos Asignados (@Model.Permisos.Count)</h5>
                </div>
                
                @if (Model.Permisos.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var permiso in Model.Permisos)
                        {
                            <li class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@permiso.Nombre</h6>
                                    <small><i class="bi bi-check-circle text-success"></i></small>
                                </div>
                                @if (!string.IsNullOrEmpty(permiso.Descripcion))
                                {
                                    <p class="mb-1 text-muted small">@permiso.Descripcion</p>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="card-body d-flex align-items-center justify-content-center">
                        <p class="text-muted fst-italic mb-0">
                            Este grupo no tiene permisos asignados.
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .display-1 { /* Icono grande */
            font-size: 6rem; 
        }
        .card-header h5 {
             margin-bottom: 0;
        }
    </style>
}