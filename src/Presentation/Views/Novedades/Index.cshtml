@model IEnumerable<src.Presentation.ViewModels.NovedadesVM.NovedadesListarViewModel>

@{
    ViewData["Title"] = "Gestión de Novedades";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-inbox-fill me-2"></i>Novedades de Importación</h2>
        <a asp-controller="ProductoProveedor" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver a Productos
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="text-muted mb-3"><i class="bi bi-check2-circle display-1"></i></div>
                    <h4 class="text-muted">No hay novedades pendientes</h4>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="tablaNovedades">
                        <thead class="table-light">
                            <tr>
                                <th>Código (Excel)</th>
                                <th>Nombre Sugerido</th>
                                <th>Precio (Excel)</th>
                                <th>Proveedor</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-dark border font-monospace">@item.CodigoBarraExterno</span></td>
                                    <td>@item.NombreSugerido</td>
                                    <td>
                                        @if(item.PrecioSugerido > 0) { <span class="text-success fw-bold">$@item.PrecioSugerido.ToString("N2")</span> }
                                        else { <span class="text-muted fst-italic">Sin precio</span> }
                                    </td>
                                    <td>@item.RazonSocialProveedor</td>
                                    <td class="text-center">
                                        <a asp-action="Resolver" asp-route-id="@item.IdNovedad" class="btn btn-primary btn-sm">
                                            <i class="bi bi-pencil-square me-1"></i>Gestionar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#tablaNovedades').DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json" },
                order: [[3, 'asc']] // Ordenar por proveedor por defecto
            });
        });
    </script>
}