@model src.Presentation.ViewModels.NovedadesVM.ResolverNovedadViewModel

@{
    ViewData["Title"] = "Resolver Novedad";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-gear-fill me-2"></i>Resolver Novedad</h4>
                </div>

                <div class="card-body p-4">

                    <div class="alert alert-light border border-primary border-opacity-25 rounded-3 mb-4">
                        <h6 class="text-primary fw-bold mb-3">
                            <i class="bi bi-info-circle me-1"></i> Datos recibidos del Excel
                        </h6>
                        <div class="row">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size:0.7rem">
                                    Código Externo
                                </small>
                                <span class="fs-5 font-monospace text-dark">@Model.CodigoBarraNovedad</span>
                            </div>
                            <div class="col-md-4 mb-3 mb-md-0">
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size:0.7rem">
                                    Proveedor
                                </small>
                                <span class="fw-bold text-dark">@Model.RazonSocialProveedor</span>
                            </div>
                            <div class="col-md-4">
                                <small class="text-muted d-block text-uppercase fw-bold" style="font-size:0.7rem">
                                    Precio Excel
                                </small>
                                @if (Model.PrecioSugerido.HasValue && Model.PrecioSugerido > 0)
                                {
                                    <span class="text-success fw-bold">$@Model.PrecioSugerido.Value.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">No indicado</span>
                                }
                            </div>
                        </div>
                        <div class="mt-3 pt-3 border-top">
                            <small class="text-muted d-block text-uppercase fw-bold" style="font-size:0.7rem">
                                Nombre Sugerido
                            </small>
                            <span class="text-dark fst-italic">
                                @(string.IsNullOrEmpty(Model.NombreSugerido) ? "-" : Model.NombreSugerido)
                            </span>
                        </div>
                    </div>
                    <form asp-action="Resolver" method="post" id="formResolver">
                        <input type="hidden" asp-for="IdNovedad" />
                        <input type="hidden" asp-for="RazonSocialProveedor" />
                        <input type="hidden" asp-for="CodigoBarraNovedad" />
                        <input type="hidden" asp-for="NombreSugerido" />
                        <input type="hidden" asp-for="PrecioSugerido" />

                        <div class="row g-4">
                            <div class="col-12">
                                <label asp-for="IdProductoSeleccionado" class="form-label fw-bold h5 text-secondary">
                                    1. Asociar con Producto del Sistema
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                                    <select asp-for="IdProductoSeleccionado" asp-items="Model.ProductosDisponibles"
                                        class="form-select form-select-lg" data-live-search="true">
                                        <option value="">-- Buscar producto por Nombre --</option>
                                    </select>
                                </div>
                                <span asp-validation-for="IdProductoSeleccionado" class="text-danger small"></span>
                                <div class="form-text mt-2">
                                    <i class="bi bi-info-circle"></i>
                                    Si selecciona un producto que <strong>ya vende</strong> este proveedor, se
                                    actualizarán sus datos.
                                    Si el proveedor <strong>no lo vendía</strong>, se creará la relación.
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PrecioFinal" class="form-label fw-bold">2. Precio de Costo Final</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="PrecioFinal" type="number" step="0.01" class="form-control" />
                                </div>
                                <span asp-validation-for="PrecioFinal" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="StockFinal" class="form-label fw-bold">3. Stock para Asignar</label>
                                <input asp-for="StockFinal" type="number" class="form-control" />
                                <span asp-validation-for="StockFinal" class="text-danger small"></span>
                            </div>
                        </div>
                    </form>
                    <hr class="my-4">

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>

                        <div class="d-flex gap-2">

                            <form asp-controller="Novedades" asp-action="Rechazar" method="post"
                                style="display: inline;">
                                <input type="hidden" name="idNovedad" value="@Model.IdNovedad" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger"
                                    onclick="return confirm('¿Está seguro de RECHAZAR esta novedad? Se marcará como descartada.');">
                                    <i class="bi bi-x-circle me-1"></i> Rechazar
                                </button>
                            </form>

                            <button type="submit" form="formResolver" class="btn btn-success px-4">
                                <i class="bi bi-check-lg me-1"></i> Confirmar y Asociar
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
            $('select').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: '-- Buscar producto por Nombre o SKU --',
                allowClear: true
            });
        });
    </script>
}