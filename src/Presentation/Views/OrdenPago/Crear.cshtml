@using src.Presentation.ViewModels.CuentaCorrienteVM
@model OrdenPagoFormVM

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-success mb-1"><i class="bi bi-wallet2 me-2"></i>Nueva Orden de Pago</h2>
            <p class="text-muted">Proveedor: <strong>@Model.RazonSocialProveedor</strong></p>
        </div>
        <a asp-action="Index" asp-route-idProveedor="@Model.IdProveedor" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger border-0 shadow-sm mb-4">
            <h6 class="fw-bold"><i class="bi bi-exclamation-circle me-2"></i>Error al procesar el pago</h6>
            <div asp-validation-summary="All" class="small"></div>
        </div>
    }
<form method="post" asp-action="Crear" id="formOrdenPago">
    @Html.HiddenFor(m => m.IdProveedor)
    @Html.HiddenFor(m => m.RazonSocialProveedor)

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                <div class="card-body">
                    <h6 class="fw-bold text-muted small mb-3 text-uppercase">Datos de la Orden</h6>
                    
                    <div class="mb-3">
                        <label asp-for="NumeroOrden" class="form-label small fw-bold text-muted">N° ORDEN (AUTO)</label>
                        <input asp-for="NumeroOrden" class="form-control bg-light" readonly placeholder="Generado por el sistema" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="FechaPago" class="form-label small fw-bold text-muted">FECHA DE PAGO</label>
                        <input asp-for="FechaPago" type="date" class="form-control" />
                    </div>

                    <div class="p-3 bg-light rounded text-center border mb-3">
                        <small class="text-muted fw-bold d-block mb-1">TOTAL A PAGAR</small>
                        <h2 class="fw-bold text-success mb-0" id="displayTotal">$0,00</h2>
                        <small class="text-muted" id="displayCantidad">0 facturas seleccionadas</small>
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100 fw-bold shadow-sm" id="btnGuardar">
                        <i class="bi bi-save me-2"></i>Guardar Orden
                    </button>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <table class="table align-middle mb-0">
                    <thead class="bg-light small text-muted">
                        <tr>
                            <th class="text-center" style="width: 50px;"></th>
                            <th>FACTURA</th>
                            <th class="text-end">SALDO</th>
                            <th class="text-end" style="width: 180px;">PAGO</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.FacturasDisponibles.Count; i++)
                        {
                            <tr class="fila-factura">
                                <td class="text-center ps-3">
                                    <input type="hidden" asp-for="FacturasDisponibles[i].IdFactura" />
                                    <input type="hidden" asp-for="FacturasDisponibles[i].SaldoPendiente" class="val-saldo-hidden" />
                                    <input asp-for="FacturasDisponibles[i].EstaSeleccionada" class="form-check-input chk-seleccion" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@Model.FacturasDisponibles[i].NumeroFactura</div>
                                    <small class="text-muted">@Model.FacturasDisponibles[i].FechaEmision.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td class="text-end text-danger fw-bold">
                                    $@Model.FacturasDisponibles[i].SaldoPendiente.ToString("N2")
                                </td>
                                <td class="pe-3">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="FacturasDisponibles[i].MontoAPagar" 
                                               class="form-control text-end input-monto" 
                                               type="number" step="0.01" readonly />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</form>
   </div>

   @section Scripts {
    <script>
        $(document).ready(function() {
            function calcular() {
                let total = 0;
                let c = 0;
                $('.fila-factura').each(function() {
                    let chk = $(this).find('.chk-seleccion');
                    let inp = $(this).find('.input-monto');
                    let saldo = parseFloat($(this).find('.val-saldo-hidden').val());

                    if (chk.is(':checked')) {
                        inp.prop('readonly', false).addClass('bg-white');
                        // Si está vacío o es 0 al marcar, ponemos el saldo total
                        if(parseFloat(inp.val()) <= 0) inp.val(saldo.toFixed(2));
                        total += parseFloat(inp.val()) || 0;
                        c++;
                    } else {
                        inp.prop('readonly', true).removeClass('bg-white').val(0);
                    }
                });
                $('#displayTotal').text('$' + total.toLocaleString('es-AR', {minimumFractionDigits:2}));
                $('#displayCantidad').text(c + ' facturas seleccionadas');
            }

            $('.chk-seleccion, .input-monto').on('change input', calcular);
            calcular();
        });
    </script>
}
