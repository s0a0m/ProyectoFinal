@using src.Presentation.ViewModels.CuentaCorrienteVM
@model ModuloOrdenesPagoVM

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-primary mb-1">Gestión de pagos</h2>
            <p class="text-muted mb-0">Proveedor: <strong>@Model.RazonSocialProveedor</strong></p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Crear" asp-route-idProveedor="@Model.IdProveedor" class="btn btn-sm btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Nueva orden
            </a>
            <a asp-controller="Proveedor" asp-action="CuentaCorriente" asp-route-id="@Model.IdProveedor"
                class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Cuenta corriente
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-2 d-flex gap-2">
            <button class="btn btn-sm btn-outline-secondary active filter-btn" data-filter="">Todas</button>
            <button class="btn btn-sm btn-outline-success filter-btn" data-filter="Confirmada">Confirmadas</button>
            <button class="btn btn-sm btn-outline-warning filter-btn" data-filter="Borrador">Borradores</button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table id="tablaOrdenes" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Fecha pago</th>
                        <th>N° orden</th>
                        <th class="text-center">Facturas</th>
                        <th class="text-end">Monto total</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Ordenes.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox d-block mb-2" style="font-size: 2rem;"></i>
                                No hay órdenes de pago registradas.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model.Ordenes)
                    {
                        <tr>
                            <td>
                                @if (item.FechaPago == DateTime.MinValue)
                                {
                                    <span class="text-muted small fst-italic">Sin fecha</span>
                                }
                                else
                                {
                                    @item.FechaPago.ToString("dd/MM/yyyy")
                                }
                            </td>
                            <td class="fw-bold">@item.Numero</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@item.CantidadFacturasAfectadas</span>
                            </td>
                            <td class="text-end fw-bold">$@item.MontoTotal.ToString("N2")</td>
                            <td class="text-center">
                                @if (item.Enviada)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill">Confirmada</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill">Borrador</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                        onclick="verDetalleOrden(@item.IdOrdenPago)" title="Ver detalle">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    @if (!item.Enviada)
                                    {
                                        @using (Html.BeginForm("Confirmar", "OrdenPago", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('¿Confirmar orden? Esto actualizará los saldos.')" }))
                                        {
                                            <input type="hidden" name="id" value="@item.IdOrdenPago" />
                                            <input type="hidden" name="idProveedor" value="@Model.IdProveedor" />
                                            <button type="submit" class="btn btn-outline-success btn-sm" title="Confirmar">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        }
                                        @using (Html.BeginForm("Eliminar", "OrdenPago", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('¿Eliminar esta orden? No se puede deshacer.')" }))
                                        {
                                            <input type="hidden" name="id" value="@item.IdOrdenPago" />
                                            <input type="hidden" name="idProveedor" value="@Model.IdProveedor" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetalleOrden" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="contenidoModalOrden">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var table = $('#tablaOrdenes').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json" },
                "order": [[0, "desc"]],
                "pageLength": 25
            });

            $('.filter-btn').on('click', function() {
                $('.filter-btn').removeClass('active btn-secondary').addClass('btn-outline-secondary');
                $(this).removeClass('btn-outline-secondary').addClass('active btn-secondary');
                var status = $(this).data('filter');
                table.column(4).search(status).draw();
            });
        });

        function verDetalleOrden(idOrden) {
            var myModal = new bootstrap.Modal(document.getElementById('modalDetalleOrden'));
            myModal.show();
            $.get('/OrdenesPago/ObtenerDetalleModal/' + idOrden)
                .done(function(data) { $('#contenidoModalOrden').html(data); })
                .fail(function() {
                    $('#contenidoModalOrden').html(
                        '<div class="modal-header"><h5 class="modal-title">Error</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>' +
                        '<div class="modal-body text-danger">No se pudo cargar el detalle.</div>'
                    );
                });
            document.getElementById('modalDetalleOrden').addEventListener('hidden.bs.modal', function() {
                $('#contenidoModalOrden').html('<div class="modal-body text-center py-5"><div class="spinner-border text-primary"></div></div>');
            }, { once: true });
        }
    </script>
}

