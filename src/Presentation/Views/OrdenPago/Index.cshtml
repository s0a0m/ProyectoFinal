@using src.Presentation.ViewModels.CuentaCorrienteVM
@model ModuloOrdenesPagoVM

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    @* Corregido el link a ListarProveedores *@
                    <li class="breadcrumb-item"><a asp-controller="Proveedor" asp-action="ListarProveedores">Proveedores</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Proveedor" asp-action="CuentaCorriente" asp-route-id="@Model.IdProveedor">Cuenta Corriente</a></li>
                    <li class="breadcrumb-item active">Pagos</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">Gestión de Pagos</h2>
            <p class="text-muted">Proveedor: <span class="fw-bold text-primary">@Model.RazonSocialProveedor</span></p>
        </div>
        <a asp-action="Crear" asp-route-idProveedor="@Model.IdProveedor" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nueva Orden
        </a>
    </div>

    @* Mensajes de Feedback *@
    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="alert @(TempData["Success"] != null ? "alert-success" : "alert-danger") border-0 shadow-sm mb-4 alert-dismissible fade show">
            <i class="bi @(TempData["Success"] != null ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-2"></i>
            @(TempData["Success"] ?? TempData["Error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-2 d-flex gap-2 bg-light rounded">
            <button class="btn btn-sm filter-btn active btn-secondary" data-filter="">Todas</button>
            <button class="btn btn-sm filter-btn btn-outline-secondary" data-filter="Confirmada">Confirmadas</button>
            <button class="btn btn-sm filter-btn btn-outline-secondary" data-filter="Borrador">Borradores</button>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table id="tablaOrdenes" class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr class="text-muted small text-uppercase">
                        <th class="ps-4">Fecha Pago</th>
                        <th>N° Orden</th>
                        <th class="text-center">Comprobantes</th>
                        <th class="text-end">Monto Total</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Ordenes)
                    {
                        <tr>
                            <td class="ps-4">@(item.FechaPago == DateTime.MinValue ? "---" : item.FechaPago.ToString("dd/MM/yyyy"))</td>
                            <td class="fw-bold text-dark">@item.Numero</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@item.CantidadFacturasAfectadas</span>
                            </td>
                            <td class="text-end fw-bold text-dark">$@item.MontoTotal.ToString("N2")</td>
                            <td class="text-center">
                                @if (item.Enviada)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Confirmada</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3">Borrador</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm">
                                    <button type="button" class="btn btn-white btn-sm border btn-detalle" data-id="@item.IdOrdenPago" title="Ver Detalle">
                                        <i class="bi bi-eye text-primary"></i>
                                    </button>
                                    @if (!item.Enviada)
                                    {
                                        <form asp-action="Confirmar" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.IdOrdenPago" />
                                            <input type="hidden" name="idProveedor" value="@Model.IdProveedor" />
                                            <button type="submit" class="btn btn-white btn-sm border" onclick="return confirm('¿Confirmar pago?')">
                                                <i class="bi bi-check-lg text-success"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Eliminar" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.IdOrdenPago" />
                                            <input type="hidden" name="idProveedor" value="@Model.IdProveedor" />
                                            <button type="submit" class="btn btn-white btn-sm border" onclick="return confirm('¿Eliminar borrador?')">
                                                <i class="bi bi-trash text-danger"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetalleOrden" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="contenidoModalOrden"></div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // 1. Inicialización de la tabla
            var table = $('#tablaOrdenes').DataTable({
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json" },
                "order": [[0, "desc"]],
                "dom": "rtp"
            });

            // 2. Filtros (Estado)
            $('.filter-btn').on('click', function() {
                $('.filter-btn').removeClass('active btn-secondary').addClass('btn-outline-secondary');
                $(this).removeClass('btn-outline-secondary').addClass('active btn-secondary');
                table.column(4).search($(this).data('filter')).draw();
            });

            // 3. AJAX para el modal (CORREGIDO CON DELEGACIÓN)
            // Escuchamos el click en el body o en la tabla, pero filtramos por la clase .btn-detalle
            $('#tablaOrdenes').on('click', '.btn-detalle', function() {
                var id = $(this).data('id');
                
                // Limpiar contenido previo y poner spinner
                $('#contenidoModalOrden').html('<div class="p-5 text-center"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted">Cargando...</p></div>');
                
                // Mostrar el modal
                var modalElement = document.getElementById('modalDetalleOrden');
                var myModal = new bootstrap.Modal(modalElement);
                myModal.show();

                // Petición AJAX
                $.get('@Url.Action("ObtenerDetalleModal", "OrdenesPago")/' + id)
                    .done(function(data) {
                        $('#contenidoModalOrden').html(data);
                    })
                    .fail(function() {
                        $('#contenidoModalOrden').html('<div class="alert alert-danger m-3">No se pudo cargar el detalle de la orden.</div>');
                    });
            });
        });
    </script>
}
