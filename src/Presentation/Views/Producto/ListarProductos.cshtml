@using src.Presentation.ViewModels.ProductoVM
@model IEnumerable<ProductoListarViewModel>

@{
    ViewData["Title"] = "Inventario de Productos";
    
    // Cálculos para KPIs
    var totalProductosActivos = Model.Count(p => p.Activo);
    var productosBajoStock = Model.Count(p => p.EnAlertaStock && p.Activo); // Solo activos con bajo stock
    var productosInactivos = Model.Count(p => !p.Activo);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="row mb-4">
    
    <div class="col-md-4" style="cursor: pointer;" onclick="resetearFiltros()">
        <div class="card border-start border-primary border-4 shadow-sm py-2 h-100 zoom-hover">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Ver Activos (Total)</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@totalProductosActivos</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-box-seam text-gray-300" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4" style="cursor: pointer;" onclick="filtrarBajoStock()">
        <div class="card border-start border-danger border-4 shadow-sm py-2 h-100 zoom-hover">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Alertas de Stock</div>
                        <div class="h5 mb-0 font-weight-bold text-danger">@productosBajoStock</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4" style="cursor: pointer;" onclick="filtrarInactivos()">
        <div class="card border-start border-secondary border-4 shadow-sm py-2 h-100 zoom-hover">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">Ver Inactivos</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@productosInactivos</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-archive-fill text-secondary" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white">
        <h6 class="m-0 font-weight-bold text-primary" id="tituloTabla">Listado de Productos Activos</h6>
        <a asp-controller="Producto" asp-action="CrearProducto" class="btn btn-primary btn-sm shadow-sm">
            <i class="bi bi-plus-lg text-white-50 me-1"></i>Nuevo Producto
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle" id="tablaProductos" width="100%" cellspacing="0">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Códigos</th>
                        <th>Clasificación</th> 
                        <th class="text-center">Stock</th>
                        <th class="text-center">Estado</th> <th class="text-center" style="width: 150px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.EnAlertaStock ? "fila-bajo-stock" : "")" 
                            data-activo="@(item.Activo ? "true" : "false")">
                            
                            <td class="fw-bold text-dark">@item.Nombre</td>

                            <td>
                                <i class="bi bi-upc-scan text-muted me-1"></i>
                                <span class="small font-monospace">@item.CodigosBarra</span>
                            </td>

                            <td>
                                <span class="badge bg-light text-dark border">@item.Categorias</span>
                            </td>

                            <td class="text-center">
                                @if (item.EnAlertaStock)
                                {
                                    <span class="text-danger fw-bold" title="Stock Bajo (Mínimo: @item.StockMinimo)">
                                        <i class="bi bi-exclamation-circle-fill me-1"></i>@item.StockTotal
                                    </span>
                                }
                                else
                                {
                                    <span class="text-success fw-bold">@item.StockTotal</span>
                                }
                                <small class="d-block text-muted" style="font-size: 0.7em;">Mín: @item.StockMinimo</small>
                            </td>

                            <td class="text-center">
                                @if (item.Activo)
                                {
                                    <span class="badge bg-success rounded-pill estado-texto">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill estado-texto">Inactivo</span>
                                }
                            </td>

                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <button type="button" 
                                            class="btn btn-info btn-sm text-white me-1" 
                                            title="Ver Detalle"
                                            data-bs-toggle="modal" 
                                            data-bs-target="#modalDetalleProducto"
                                            data-nombre="@item.Nombre"
                                            data-codigos="@item.CodigosBarra"
                                            data-categorias="@item.Categorias"
                                            data-stock="@item.StockTotal"
                                            data-stockmin="@item.StockMinimo"
                                            data-estado="@(item.Activo ? "Activo" : "Inactivo")"
                                            data-enalerta="@(item.EnAlertaStock ? "true" : "false")">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                    
                                    
                                    
                                    @if (item.Activo)
                                    {
                                        <a asp-action="ActualizarProducto"      asp-route-id="@item.IdProducto" class="btn btn-warning btn-sm text-white" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                        </a>


                                        <form asp-action="EliminarProducto" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de desactivar este producto?');">
                                            <input type="hidden" name="id" value="@item.IdProducto" />
                                            <button type="submit" class="btn btn-danger btn-sm rounded-0 rounded-end" title="Desactivar">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                       <form asp-controller="Producto" 
                                            asp-action="ReactivarProducto" 
                                            asp-route-id="@item.IdProducto" 
                                            method="post" 
                                            class="d-inline" 
                                            onsubmit="return confirm('¿Desea reactivar este producto?');">
                                            
                                            <button type="submit" class="btn btn-success btn-sm rounded-0 rounded-end" title="Reactivar Producto">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetalleProducto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">
                    <i class="bi bi-box-seam me-2"></i>Detalle del Producto
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark" id="detalleNombre">Nombre Producto</h3>
                    <span class="badge rounded-pill" id="detalleEstado">Activo</span>
                </div>

                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 border rounded bg-light h-100 text-center">
                            <small class="text-muted text-uppercase fw-bold">Stock Actual</small>
                            <div class="fs-2 fw-bold" id="detalleStock">0</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 border rounded bg-light h-100 text-center">
                            <small class="text-muted text-uppercase fw-bold">Stock Mínimo</small>
                            <div class="fs-2 text-secondary" id="detalleStockMin">0</div>
                        </div>
                    </div>
                    
                    <div class="col-12" id="alertaStockDiv" style="display: none;">
                        <div class="alert alert-danger d-flex align-items-center mb-0 p-2">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-4"></i>
                            <div><strong>¡Atención!</strong> El stock está por debajo del mínimo.</div>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="fw-bold text-secondary small">CÓDIGOS DE BARRA</label>
                        <div class="p-2 border rounded bg-white d-flex align-items-center text-break">
                            <i class="bi bi-upc-scan me-2 text-muted fs-4"></i>
                            <span class="font-monospace" id="detalleCodigos">...</span>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="fw-bold text-secondary small">CLASIFICACIÓN</label>
                        <div class="p-2 border rounded bg-white">
                            <i class="bi bi-tags-fill me-2 text-muted"></i>
                            <span id="detalleCategorias">...</span>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            
            // 1. Inicialización de DataTables
            var table = $('#tablaProductos').DataTable({
                // Configuración de idioma
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json"
                },
                // Orden inicial (por Producto)
                order: [[0, 'asc']], 
                // Cantidad de filas por página
                pageLength: 10, 
                
                // --- AQUÍ AGREGAMOS LA NUEVA CONFIGURACIÓN ---
                columnDefs: [
                    // 'targets': Índices de columnas (empiezan en 0)
                    // 1 = Códigos, 4 = Estado, 5 = Acciones -> NO ORDENABLES
                    { orderable: false, targets: [1, 4, 5] },
                    // 0 = Producto, 2 = Clasif, 3 = Stock -> SÍ ORDENABLES (es el default, pero explícito)
                    { orderable: true, targets: [0, 2, 3] }
                ],
                // ---------------------------------------------

                // Diseño de controles (Buscador y Paginación estilo Bootstrap 5)
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
            });

            // 2. Lógica de Filtrado Personalizado (Extension de DataTables)
            $.fn.dataTable.ext.search.push(
                function(settings, data, dataIndex) {
                    // Obtenemos la fila HTML actual
                    var row = table.row(dataIndex).node();
                    // Leemos el atributo data-activo
                    var esActivo = $(row).attr('data-activo') === 'true';
                    
                    // Leemos el estado actual del filtro (variable global o default 'activos')
                    var estadoFiltro = window.estadoFiltroActual || 'activos'; 

                    // Aplicamos lógica según el botón presionado
                    if (estadoFiltro === 'activos') {
                        return esActivo; // Muestra solo activos
                    } else if (estadoFiltro === 'inactivos') {
                        return !esActivo; // Muestra solo inactivos
                    } else if (estadoFiltro === 'bajo_stock') {
                        // Muestra activos QUE ADEMÁS tengan la clase de bajo stock
                        return esActivo && $(row).hasClass('fila-bajo-stock');
                    }
                    return true; // Fallback
                }
            );

            // 3. Estado Inicial
            window.estadoFiltroActual = 'activos';
            table.draw(); // Aplicar el filtro inicial

            // 4. Funciones Globales para los Botones de las Tarjetas
            
            // Botón Azul (Total) -> Resetea a ver solo activos
            window.resetearFiltros = function() {
                window.estadoFiltroActual = 'activos';
                // Cambiamos el título de la tabla visualmente
                $('#tituloTabla').text('Listado de Productos Activos');
                // Redibujamos la tabla (esto dispara el filtro de arriba)
                table.draw();
            };

            // Botón Gris (Inactivos) -> Ver solo inactivos
            window.filtrarInactivos = function() {
                window.estadoFiltroActual = 'inactivos';
                $('#tituloTabla').text('Papelera: Productos Inactivos');
                table.draw();
            };

            // Botón Rojo (Alertas) -> Ver solo stock bajo
            window.filtrarBajoStock = function() {
                window.estadoFiltroActual = 'bajo_stock';
                $('#tituloTabla').text('⚠️ Alertas: Productos con Bajo Stock');
                table.draw();
            };
        });
        var modalDetalle = document.getElementById('modalDetalleProducto');
        modalDetalle.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;

            // Extraer datos
            var nombre = button.getAttribute('data-nombre');
            var codigos = button.getAttribute('data-codigos');
            var categorias = button.getAttribute('data-categorias');
            var stock = button.getAttribute('data-stock');
            var stockMin = button.getAttribute('data-stockmin');
            var estado = button.getAttribute('data-estado');
            var enAlerta = button.getAttribute('data-enalerta') === 'true';

            // Inyectar en el Modal
            modalDetalle.querySelector('#detalleNombre').textContent = nombre;
            modalDetalle.querySelector('#detalleCodigos').textContent = codigos;
            modalDetalle.querySelector('#detalleCategorias').textContent = categorias;
            modalDetalle.querySelector('#detalleStock').textContent = stock;
            modalDetalle.querySelector('#detalleStockMin').textContent = stockMin;
            
            // Estilar Estado
            var badgeEstado = modalDetalle.querySelector('#detalleEstado');
            badgeEstado.textContent = estado;
            if (estado === 'Activo') {
                badgeEstado.className = 'badge rounded-pill bg-success';
            } else {
                badgeEstado.className = 'badge rounded-pill bg-secondary';
            }

            // Estilar Stock y Alerta
            var divStock = modalDetalle.querySelector('#detalleStock');
            var divAlerta = modalDetalle.querySelector('#alertaStockDiv');

            if (enAlerta) {
                divStock.className = 'fs-2 fw-bold text-danger';
                divAlerta.style.display = 'block';
            } else {
                divStock.className = 'fs-2 fw-bold text-success';
                divAlerta.style.display = 'none';
            }
        });
    </script>

    <style>
        .zoom-hover {
            transition: transform 0.2s;
        }
        .zoom-hover:hover {
            transform: scale(1.03);
            cursor: pointer;
        }
        /* Estilo visual para filas inactivas */
        tr[data-activo="false"] td {
            color: #6c757d !important;
            background-color: #f8f9fa;
        }
    </style>
}