@using src.Presentation.ViewModels.ProductoVM
@model CrearProductoProveedorViewModel

@{
    ViewData["Title"] = "Asignar Producto a Proveedor";
}

<main class="container py-4" style="max-width: 800px;">
    
    <form asp-controller="ProductoProveedor" asp-action="Create" method="post" class="shadow-lg rounded bg-light p-5" id="formProductoProveedor">
        
        <div class="text-center mb-4">
            <h2 class="text-primary fw-bold"><i class="bi bi-link-45deg me-2"></i>@ViewData["Title"]</h2>
            <p class="text-muted">Vincule un producto existente con un proveedor y establezca sus condiciones comerciales.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Error de validación:</strong>
                <ul class="mb-0 mt-1 small">
                     @foreach (var state in ViewData.ModelState.Values)
                    {
                        foreach (var error in state.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <fieldset class="mb-4">
            <legend class="h5 text-primary border-bottom pb-2">
                <i class="bi bi-search me-2"></i>Selección de Entidades
            </legend>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="IdProducto" class="form-label fw-bold">Producto</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-box-seam"></i></span>
                        <select asp-for="IdProducto" class="form-select" asp-items="@(new SelectList(Model.ListaProductos, "Id", "Descripcion"))">
                            <option value="">-- Seleccione un Producto --</option>
                        </select>
                    </div>
                    <span asp-validation-for="IdProducto" class="text-danger small"></span>
                    <div class="form-text small">El producto debe estar creado previamente.</div>
                </div>

                <div class="col-md-6">
                    <label asp-for="IdProveedor" class="form-label fw-bold">Proveedor</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-shop"></i></span>
                        <select asp-for="IdProveedor" class="form-select" asp-items="@(new SelectList(Model.ListaProveedores, "Id", "Descripcion"))">
                            <option value="">-- Seleccione un Proveedor --</option>
                        </select>
                    </div>
                    <span asp-validation-for="IdProveedor" class="text-danger small"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="mb-4">
            <legend class="h5 text-primary border-bottom pb-2">
                <i class="bi bi-currency-dollar me-2"></i>Condiciones Comerciales
            </legend>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Precio" class="form-label fw-bold">Precio de Costo</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Precio" class="form-control" type="number" step="0.01" placeholder="0.00">
                    </div>
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="StockAsignado" class="form-label fw-bold">Stock Asignado</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-boxes"></i></span>
                        <input asp-for="StockAsignado" class="form-control" type="number" placeholder="0">
                    </div>
                    <span asp-validation-for="StockAsignado" class="text-danger small"></span>
                    <div class="form-text small">Cantidad física disponible de este proveedor.</div>
                </div>
            </div>
        </fieldset>

        <fieldset class="mb-4">
            <legend class="h5 text-primary border-bottom pb-2">
                <i class="bi bi-upc-scan me-2"></i>Identificación Externa
            </legend>
            
            <div class="alert alert-info d-flex align-items-center p-2 mb-3 shadow-sm" style="font-size: 0.9em;">
                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                <div>
                    Este código es útil para actualizaciones automáticas de precios mediante Excel o escaneo directo de productos del proveedor.
                </div>
            </div>

            <div class="form-floating mb-2">
                <input asp-for="CodigoBarraExterno" class="form-control" placeholder="Escanear código aquí...">
                <label asp-for="CodigoBarraExterno">Código de Barra del Proveedor (Opcional)</label>
            </div>
            <span asp-validation-for="CodigoBarraExterno" class="text-danger small"></span>
        </fieldset>

        <div class="d-flex justify-content-end gap-2 mt-5">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i>Cancelar
            </a>
            <button class="btn btn-success px-5 fw-bold shadow-sm" type="submit">
                <i class="bi bi-check-lg me-1"></i>Guardar Relación
            </button>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Pequeña mejora de UX: Si el usuario escanea un código de barras en el input de Código Externo
        // y presiona enter, evitamos que se envíe el formulario accidentalmente (comportamiento común de scanners).
        document.getElementById('CodigoBarraExterno').addEventListener('keypress', function(event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                // Opcional: Pasar el foco al botón de guardar
                // document.querySelector('button[type="submit"]').focus();
            }
        });
    </script>
}