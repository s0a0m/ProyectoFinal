@using src.Presentation.ViewModels.ProductoVM
@model CrearProductoProveedorViewModel

@{
    ViewData["Title"] = "Asignar Producto a Proveedor";
}

<main class="container py-4" style="max-width: 800px;">

    <form asp-controller="ProductoProveedor" asp-action="Create" method="post" class="shadow-lg rounded bg-light p-5"
        id="formProductoProveedor">

        <div class="text-center mb-4">
            <h2 class="text-primary fw-bold"><i class="bi bi-link-45deg me-2"></i>@ViewData["Title"]</h2>
            <p class="text-muted">Vincule un producto existente con un proveedor y establezca sus condiciones
                comerciales.</p>
        </div>

        @* @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Error de validación:</strong>
                <ul class="mb-0 mt-1 small">
                    @foreach (var state in ViewData.ModelState.Values)
                    {
                        foreach (var error in state.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        } *@

        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show shadow-sm"
            role="alert">
            <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Atención:</strong>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <fieldset class="mb-4">
            <legend class="h5 text-primary border-bottom pb-2">
                <i class="bi bi-search me-2"></i>Selección de Entidades
            </legend>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="IdProducto" class="form-label fw-bold">Producto</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-box-seam"></i></span>
                        <select asp-for="IdProducto" class="form-select"
                            asp-items="@(new SelectList(Model.ListaProductos, "Id", "Descripcion"))">
                            <option value="">-- Seleccione un Producto --</option>
                        </select>
                    </div>
                    <span asp-validation-for="IdProducto" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="IdProveedor" class="form-label fw-bold">Proveedor</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-shop"></i></span>
                        <select asp-for="IdProveedor" class="form-select"
                            asp-items="@(new SelectList(Model.ListaProveedores, "Id", "Descripcion"))">
                            <option value="">-- Seleccione un Proveedor --</option>
                        </select>
                    </div>
                    <span asp-validation-for="IdProveedor" class="text-danger small"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="mb-4">
            <legend class="h5 text-primary border-bottom pb-2">
                <i class="bi bi-currency-dollar me-2"></i>Condiciones Comerciales
            </legend>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Precio" class="form-label fw-bold">Precio de Costo</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Precio" class="form-control" type="number" step="0.01" placeholder="0.00">
                    </div>
                    <span asp-validation-for="Precio" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="StockAsignado" class="form-label fw-bold">Stock Asignado</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-boxes"></i></span>
                        <input asp-for="StockAsignado" class="form-control" type="number" placeholder="0">
                    </div>
                    <span asp-validation-for="StockAsignado" class="text-danger small"></span>
                </div>
            </div>
        </fieldset>

        <fieldset class="mb-4">
            <legend class="h5 text-primary border-bottom pb-2">
                <i class="bi bi-upc-scan me-2"></i>Identificación Externa
            </legend>

            <div class="alert alert-info d-flex align-items-center p-2 mb-3 shadow-sm small">
                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                <div>Puede asociar múltiples códigos de barra (EAN, UPC, propios del proveedor) para identificar este
                    producto al escanearlo.</div>
            </div>

            <div class="input-group mb-2">
                <span class="input-group-text bg-white"><i class="bi bi-plus-circle"></i></span>
                <input type="text" class="form-control" id="inputNuevoCodigo" maxlength="30"
                    placeholder="Escanear o escribir código...">
                <button class="btn btn-secondary" type="button" id="btnAgregarCodigo">Agregar</button>
            </div>
            <span asp-validation-for="CodigosBarraExternos" class="text-danger small d-block mb-2"></span>
            <span id="msgErrorCodigo" class="text-danger small d-block mb-2"></span>

            <div class="list-group" id="listaCodigosVisual">
                @if (Model.CodigosBarraExternos != null)
                {
                    foreach (var codigo in Model.CodigosBarraExternos)
                    {
                        <div
                            class="list-group-item d-flex justify-content-between align-items-center item-codigo animate__animated animate__fadeIn">
                            <span class="font-monospace"><i class="bi bi-barcode me-2 text-muted"></i>@codigo</span>
                            <input type="hidden" name="CodigosBarraExternos" value="@codigo">
                            <button type="button" class="btn btn-sm btn-outline-danger btn-borrar-codigo" title="Quitar"><i
                                    class="bi bi-x-lg"></i></button>
                        </div>
                    }
                }
            </div>
        </fieldset>

        <div class="d-flex justify-content-end gap-2 mt-5">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i>Cancelar
            </a>
            <button class="btn btn-success px-5 fw-bold shadow-sm" type="submit">
                <i class="bi bi-check-lg me-1"></i>Guardar Relación
            </button>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> *@

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            @* const serviceError = '@TempData["ServiceErrorMessage"]';
            const serviceSuccess = '@TempData["ServiceSuccessMessage"]';

            if (serviceError) {
                Swal.fire({ icon: 'error', title: 'Error de negocio', text: serviceError });
            }

            if (serviceSuccess) {
                Swal.fire({ icon: 'success', title: '¡Excelente!', text: serviceSuccess, timer: 3000, showConfirmButton: false });
            } *@

                const inputCodigo = document.getElementById('inputNuevoCodigo');
            const btnAgregar = document.getElementById('btnAgregarCodigo');
            const listaVisual = document.getElementById('listaCodigosVisual');
            const msgError = document.getElementById('msgErrorCodigo');

            // Función para agregar código a la lista
            function agregarCodigo() {
                const codigo = inputCodigo.value.trim();
                msgError.innerText = "";
                inputCodigo.classList.remove('is-invalid');

                if (!codigo) return; // No hacer nada si está vacío

                // 1. Validar duplicados visuales (lo que ya agregué en esta sesión)
                const inputsExistentes = document.querySelectorAll('input[name="CodigosBarraExternos"]');
                for (let input of inputsExistentes) {
                    if (input.value === codigo) {
                        msgError.innerText = "Este código ya está en la lista.";
                        inputCodigo.classList.add('is-invalid');
                        inputCodigo.value = "";
                        return;
                    }
                }

                // 2. Crear Elemento Visual + Input Hidden
                const itemDiv = document.createElement('div');
                itemDiv.className = 'list-group-item d-flex justify-content-between align-items-center item-codigo';
                itemDiv.innerHTML = `
                                                                            <span class="font-monospace"><i class="bi bi-barcode me-2 text-muted"></i>${codigo}</span>
                                                                            <input type="hidden" name="CodigosBarraExternos" value="${codigo}">
                                                                            <button type="button" class="btn btn-sm btn-outline-danger btn-borrar-codigo" title="Quitar">
                                                                                <i class="bi bi-x-lg"></i>
                                                                            </button>
                                                                        `;

                listaVisual.appendChild(itemDiv);
                inputCodigo.value = ""; // Limpiar input
                inputCodigo.focus();    // Mantener foco para seguir escaneando
            }

            // Evento Click Botón Agregar
            btnAgregar.addEventListener('click', agregarCodigo);

            // Evento Enter en el Input (Evitar submit del form principal y disparar agregarCodigo)
            inputCodigo.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    agregarCodigo();
                }
            });

            // Evento Delegado para el botón borrar (funciona en elementos creados dinámicamente)
            listaVisual.addEventListener('click', function (e) {
                const btn = e.target.closest('.btn-borrar-codigo');
                if (btn) {
                    const item = btn.closest('.item-codigo');
                    item.remove();
                }
            });
        });
    </script>
}