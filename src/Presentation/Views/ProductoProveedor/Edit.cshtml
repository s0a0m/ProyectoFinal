@using src.Presentation.ViewModels.ProductoVM
@model ActualizarProductoProveedorViewModel

@{
    ViewData["Title"] = "Actualizar Relación";
}

<main class="container py-4" style="max-width: 800px;">

    <form asp-controller="ProductoProveedor" asp-action="Edit" method="post" class="shadow-lg rounded bg-light p-5">
        
        <input type="hidden" asp-for="IdProducto" />
        <input type="hidden" asp-for="IdProveedor" />

        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
            <div>
                <h2 class="text-primary fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]</h2>
                <p class="text-muted small mb-0">Modifique el precio pactado para esta relación comercial.</p>
            </div>
            <span class="badge bg-warning text-dark shadow-sm">
                <i class="bi bi-lock-fill me-1"></i>Modo Edición
            </span>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>No se pudo guardar:</strong>
                <div asp-validation-summary="All" class="small mt-1"></div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <fieldset class="mb-4">
            <legend class="h6 text-secondary text-uppercase fw-bold mb-3">
                Datos de la Relación (No editables)
            </legend>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">Producto</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-box-seam text-muted"></i></span>
                        <input type="text" class="form-control bg-light text-dark fw-bold" value="@Model.NombreProducto" disabled>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">Proveedor</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-shop text-muted"></i></span>
                        <input type="text" class="form-control bg-light text-dark fw-bold" value="@Model.RazonSocialProveedor" disabled>
                    </div>
                </div>
            </div>
        </fieldset>

        <div class="card border-primary border-1 mb-4 shadow-sm">
            <div class="card-header bg-primary text-white py-2">
                <h6 class="mb-0"><i class="bi bi-sliders me-2"></i>Condiciones Comerciales (Editables)</h6>
            </div>
            <div class="card-body bg-white p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Precio" class="form-label fw-bold text-primary">Precio de Costo</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white text-success border-primary"><i class="bi bi-currency-dollar"></i></span>
                            <input asp-for="Precio" class="form-control border-primary" type="number" step="0.01" placeholder="0.00">
                        </div>
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <fieldset class="mb-4">
            <legend class="h5 text-primary border-bottom pb-2">
                <i class="bi bi-upc-scan me-2"></i>Códigos de Barra del Proveedor
            </legend>

            <div class="alert alert-info d-flex align-items-center p-2 mb-3 shadow-sm small">
                <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                <div>Los códigos existentes no se pueden eliminar desde aquí. Puede agregar nuevos códigos adicionales.</div>
            </div>

            @if (Model.CodigosBarraExternos != null && Model.CodigosBarraExternos.Any())
            {
                <label class="form-label fw-bold text-muted small">CÓDIGOS EXISTENTES</label>
                <div class="d-flex flex-wrap gap-2 mb-3 p-3 bg-light border rounded opacity-75">
                    @foreach (var codigo in Model.CodigosBarraExternos)
                    {
                        <div class="input-group input-group-sm" style="width: auto;">
                            <span class="input-group-text bg-white"><i class="bi bi-upc-scan text-muted"></i></span>
                            <input type="text" class="form-control font-monospace bg-white"
                                value="@codigo" disabled style="max-width: 150px;">
                        </div>
                    }
                </div>
            }

            <label class="form-label fw-bold small">AGREGAR NUEVOS CÓDIGOS</label>
            <div class="input-group mb-2">
                <span class="input-group-text bg-white"><i class="bi bi-plus-circle"></i></span>
                <input type="text" class="form-control" id="inputNuevoCodigo" maxlength="30"
                    placeholder="Escanear o escribir código...">
                <button class="btn btn-secondary" type="button" id="btnAgregarCodigo">Agregar</button>
            </div>
            <span asp-validation-for="NuevosCodigosBarraExternos" class="text-danger small d-block mb-2"></span>
            <span id="msgErrorCodigo" class="text-danger small d-block mb-2"></span>

            <div class="list-group" id="listaCodigosVisual">
              
            </div>
        </fieldset>

        <div class="d-flex justify-content-between pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
            <button class="btn btn-primary px-5 fw-bold shadow" type="submit">
                <i class="bi bi-save me-1"></i>Guardar Cambios
            </button>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputCodigo = document.getElementById('inputNuevoCodigo');
            const btnAgregar = document.getElementById('btnAgregarCodigo');
            const listaVisual = document.getElementById('listaCodigosVisual');
            const msgError = document.getElementById('msgErrorCodigo');

            function agregarCodigo() {
                const codigo = inputCodigo.value.trim();
                msgError.innerText = "";
                inputCodigo.classList.remove('is-invalid');

                if (!codigo) return;

                // Validar duplicados contra los ya agregados en esta sesión
                const inputsExistentes = document.querySelectorAll('input[name="NuevosCodigosBarraExternos"]');
                for (let input of inputsExistentes) {
                    if (input.value === codigo) {
                        msgError.innerText = "Este código ya está en la lista.";
                        inputCodigo.classList.add('is-invalid');
                        inputCodigo.value = "";
                        return;
                    }
                }

                const itemDiv = document.createElement('div');
                itemDiv.className = 'list-group-item d-flex justify-content-between align-items-center item-codigo';
                itemDiv.innerHTML = `
                    <span class="font-monospace"><i class="bi bi-barcode me-2 text-muted"></i>${codigo}</span>
                    <input type="hidden" name="NuevosCodigosBarraExternos" value="${codigo}">
                    <button type="button" class="btn btn-sm btn-outline-danger btn-borrar-codigo" title="Quitar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                `;
                listaVisual.appendChild(itemDiv);
                inputCodigo.value = "";
                inputCodigo.focus();
            }

            btnAgregar.addEventListener('click', agregarCodigo);

            inputCodigo.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    agregarCodigo();
                }
            });

            listaVisual.addEventListener('click', function (e) {
                const btn = e.target.closest('.btn-borrar-codigo');
                if (btn) btn.closest('.item-codigo').remove();
            });
        });
    </script>
}
