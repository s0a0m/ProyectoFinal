@using src.Presentation.ViewModels.ProductoVM
@model ActualizarProductoProveedorViewModel

@{
    ViewData["Title"] = "Actualizar Relación";
}

<main class="container py-4" style="max-width: 800px;">

    <form asp-controller="ProductoProveedor" asp-action="Edit" method="post" class="shadow-lg rounded bg-light p-5">
        
        <input type="hidden" asp-for="IdProducto" />
        <input type="hidden" asp-for="IdProveedor" />

        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
            <div>
                <h2 class="text-primary fw-bold mb-0"><i class="bi bi-pencil-square me-2"></i>@ViewData["Title"]</h2>
                <p class="text-muted small mb-0">Modifique el precio y stock de esta relación.</p>
            </div>
            <span class="badge bg-warning text-dark shadow-sm">
                <i class="bi bi-lock-fill me-1"></i>Modo Edición
            </span>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>No se pudo guardar:</strong>
                <div asp-validation-summary="All" class="small mt-1"></div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <fieldset class="mb-4">
            <legend class="h6 text-secondary text-uppercase fw-bold mb-3">
                Datos de la Relación (No editables)
            </legend>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">Producto</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-box-seam text-muted"></i></span>
                        <input type="text" class="form-control bg-light text-dark fw-bold" value="@Model.NombreProducto" disabled>
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">Proveedor</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-shop text-muted"></i></span>
                        <input type="text" class="form-control bg-light text-dark fw-bold" value="@Model.RazonSocialProveedor" disabled>
                    </div>
                </div>
            </div>
        </fieldset>

        <div class="card border-primary border-1 mb-4 shadow-sm">
            <div class="card-header bg-primary text-white py-2">
                <h6 class="mb-0"><i class="bi bi-sliders me-2"></i>Condiciones Comerciales (Editables)</h6>
            </div>
            <div class="card-body bg-white p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Precio" class="form-label fw-bold text-primary">Precio de Costo</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white text-success border-primary"><i class="bi bi-currency-dollar"></i></span>
                            <input asp-for="Precio" class="form-control border-primary" type="number" step="0.01" placeholder="0.00">
                        </div>
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StockAsignado" class="form-label fw-bold text-primary">Stock Asignado</label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text bg-white text-primary border-primary"><i class="bi bi-boxes"></i></span>
                            <input asp-for="StockAsignado" class="form-control border-primary" type="number" placeholder="0">
                        </div>
                        <span asp-validation-for="StockAsignado" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <fieldset class="mb-4 opacity-75">
            <label class="form-label fw-bold text-muted small">CÓDIGOS DE BARRA DEL PROVEEDOR</label>
            
            <div class="bg-light p-3 border rounded">
                @if (Model.CodigosBarraExternos != null && Model.CodigosBarraExternos.Any())
                {
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var codigo in Model.CodigosBarraExternos)
                        {
                            <div class="input-group input-group-sm" style="width: auto;">
                                <span class="input-group-text bg-white"><i class="bi bi-upc-scan text-muted"></i></span>
                                <input type="text" class="form-control font-monospace bg-white" value="@codigo" disabled style="max-width: 150px;">
                            </div>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted fst-italic"><i class="bi bi-info-circle me-1"></i>Sin códigos asignados.</span>
                }
            </div>
            
            <div class="form-text small mt-2">
                <i class="bi bi-lock-fill me-1"></i>Los códigos no son editables aquí. Para modificarlos, elimine la relación y créela nuevamente.
            </div>
        </fieldset>

        <div class="d-flex justify-content-between pt-3 border-top">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i>Volver
            </a>
            <button class="btn btn-primary px-5 fw-bold shadow" type="submit">
                <i class="bi bi-save me-1"></i>Guardar Cambios
            </button>
        </div>
    </form>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}