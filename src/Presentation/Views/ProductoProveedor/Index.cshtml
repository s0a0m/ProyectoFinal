@using src.Presentation.ViewModels.ProductoVM
@using src.Presentation.Services
@model IEnumerable<ProductoProveedorListarViewModel>

@{
    ViewData["Title"] = "Relación Producto - Proveedor";
    // Simplificamos la lógica de permisos para evitar errores de sintaxis en Razor
    var tienePermiso = LayoutService.TienePermiso("P07_GESTION_COMPRAS");
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@* Alertas Estándar del Módulo de Productos *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white">
        <h6 class="m-0 font-weight-bold text-primary">Listado de Precios por Proveedor</h6>
        <div class="d-flex gap-2">
            <a asp-controller="ProductoProveedor" asp-action="Configurar" class="btn btn-success btn-sm shadow-sm">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Importar Excel
            </a>
            <a asp-controller="ProductoProveedor" asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
                <i class="bi bi-plus-lg text-white-50 me-1"></i>Asignar Nuevo
            </a>
        </div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle" id="tablaRelaciones" width="100%">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Proveedor</th>
                        <th>Códigos Externos</th>
                        <th class="text-end">Precio Costo</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.NombreProducto</td>
                            <td><i class="bi bi-truck text-muted me-1"></i>@item.NombreProveedor</td>
                            <td>
                                @if (item.CodigosBarraExternos != null && item.CodigosBarraExternos.Any())
                                {
                                    @foreach (var cod in item.CodigosBarraExternos)
                                    {
                                        <span class="badge bg-light text-dark border small">@cod</span>
                                    }
                                }
                            </td>
                            <td class="text-end fw-bold text-success">$@item.Precio.ToString("N2")</td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-info btn-sm text-white" 
                                            data-bs-toggle="modal" data-bs-target="#modalDetalleRelacion"
                                            data-producto="@item.NombreProducto" 
                                            data-proveedor="@item.NombreProveedor"
                                            data-precio="@item.Precio.ToString("N2")"
                                            data-codigos='@Json.Serialize(item.CodigosBarraExternos)'>
                                        <i class="bi bi-eye-fill"></i>
                                    </button>

                                    @if (tienePermiso)
                                    {
                                        <a asp-action="Edit" 
                                           asp-route-idProducto="@item.IdProducto" 
                                           asp-route-idProveedor="@item.IdProveedor"
                                           class="btn btn-warning btn-sm text-white ms-1">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                      <button type="button" 
        class="btn btn-sm btn-primary" 
        onclick="abrirModalCarrito('@item.IdProducto', '@item.IdProveedor', '@item.NombreProducto.Replace("'", "\\'").Replace("\"", "&quot;")')">
    <i class="bi bi-cart-plus"></i>
</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- Modal Detalle --- *@
<div class="modal fade" id="modalDetalleRelacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-info text-white py-2">
                <h6 class="modal-title">Detalle de Relación</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="p-3 bg-light rounded border text-center mb-3">
                    <h5 class="fw-bold mb-0" id="modalProducto"></h5>
                </div>
                <p class="mb-1 small text-muted">PROVEEDOR</p>
                <p class="fw-bold border-bottom pb-2" id="modalProveedor"></p>
                <div class="bg-white border rounded p-3 text-center mb-3 shadow-sm">
                    <p class="small text-muted mb-0">PRECIO COSTO</p>
                    <h3 class="text-success fw-bold mb-0" id="modalPrecio"></h3>
                </div>
                <p class="small text-muted mb-1">CÓDIGOS EXTERNOS</p>
                <div id="modalContenedorCodigos" class="d-flex flex-wrap gap-1"></div>
            </div>
        </div>
    </div>
</div>

@* --- Modal Carrito --- *@
<div class="modal fade" id="modalCantidadCarrito" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title">Agregar al Carrito</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="lblProductoCarrito" class="fw-bold text-center text-primary mb-3"></p>
                <form id="formCarrito" onsubmit="confirmarCarrito(event)">
                    <input type="hidden" id="cartIdProd" />
                    <input type="hidden" id="cartIdProv" />
                    <div class="mb-3 text-center">
                        <label class="form-label small">Cantidad</label>
                        <div class="input-group input-group-sm">
                            <button type="button" class="btn btn-outline-secondary" onclick="stepCant(-1)">-</button>
                            <input type="number" id="cartCant" class="form-control text-center" value="1" min="1" />
                            <button type="button" class="btn btn-outline-secondary" onclick="stepCant(1)">+</button>
                        </div>
                        <div id="cartError" class="text-danger small mt-2" style="display:none"></div>
                    </div>
                    <button type="submit" class="btn btn-success btn-sm w-100">Confirmar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#tablaRelaciones').DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json" },
                pageLength: 10
            });

            const modalDetalle = document.getElementById('modalDetalleRelacion');
            modalDetalle.addEventListener('show.bs.modal', function (e) {
                const b = e.relatedTarget;
                const cods = JSON.parse(b.getAttribute('data-codigos') || "[]");
                
                modalDetalle.querySelector('#modalProducto').textContent = b.getAttribute('data-producto');
                modalDetalle.querySelector('#modalProveedor').textContent = b.getAttribute('data-proveedor');
                modalDetalle.querySelector('#modalPrecio').textContent = '$' + b.getAttribute('data-precio');
                
                const cont = modalDetalle.querySelector('#modalContenedorCodigos');
                cont.innerHTML = cods.length ? cods.map(c => `<span class="badge bg-white text-dark border p-2">${c}</span>`).join('') : '<span class="text-muted small">Sin códigos</span>';
            });
        });

        let bsModalCart = null;

        function abrirModalCarrito(id, prov, nombre) {
            document.getElementById('cartIdProd').value = id;
            document.getElementById('cartIdProv').value = prov;
            document.getElementById('lblProductoCarrito').textContent = nombre;
            document.getElementById('cartCant').value = 1;
            $("#cartError").hide();

            if (!bsModalCart) bsModalCart = new bootstrap.Modal(document.getElementById('modalCantidadCarrito'));
            bsModalCart.show();
        }

        function stepCant(d) {
            const i = document.getElementById('cartCant');
            const v = (parseInt(i.value) || 0) + d;
            if (v >= 1) i.value = v;
        }

        function confirmarCarrito(e) {
            e.preventDefault();
            const data = {
                idProducto: document.getElementById('cartIdProd').value,
                idProveedor: document.getElementById('cartIdProv').value,
                cantidad: parseInt(document.getElementById('cartCant').value)
            };

            if (isNaN(data.cantidad) || data.cantidad > 2147483647) {
                $("#cartError").text("La cantidad es demasiado grande para ser procesada.").show();
                return;
            }

            if (data.cantidad < 1) {
                $("#cartError").text("La cantidad debe ser mayor a cero.").show();
                return;
            }

            $.post('/Carrito/Agregar', data)
                .done(r => {
                    const b = $("#cart-badge");
                    if (b.length) b.text(r.totalItems).show();
                    bsModalCart.hide();
                })
                .fail(x => {
                    $("#cartError").text(x.responseJSON?.mensaje || "Error").show();
                });
        }
    </script>
}
