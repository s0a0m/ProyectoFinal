@using src.Presentation.ViewModels.ProductoVM
@model IEnumerable<ProductoProveedorListarViewModel>

@{
    ViewData["Title"] = "Relación Producto - Proveedor";

    var totalRelaciones = Model.Count();
    var totalStockAsignado = Model.Sum(x => x.StockAsignado);
    var valorInventarioExterno = Model.Sum(x => x.StockAsignado * x.Precio);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card border-start border-primary border-4 shadow-sm py-2 h-100 zoom-hover">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Relaciones</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@totalRelaciones</div>
                    </div>
                    <div class="col-auto"><i class="bi bi-link-45deg text-gray-300" style="font-size: 2rem;"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-start border-success border-4 shadow-sm py-2 h-100 zoom-hover">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Stock Asignado</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@totalStockAsignado u.</div>
                    </div>
                    <div class="col-auto"><i class="bi bi-boxes text-success" style="font-size: 2rem;"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-start border-info border-4 shadow-sm py-2 h-100 zoom-hover">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Valorización</div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">$@valorInventarioExterno.ToString("N2")</div>
                    </div>
                    <div class="col-auto"><i class="bi bi-cash-coin text-info" style="font-size: 2rem;"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white">
        <h6 class="m-0 font-weight-bold text-primary">Listado de Precios y Stock por Proveedor</h6>
        <a asp-controller="ProductoProveedor" asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
            <i class="bi bi-plus-lg text-white-50 me-1"></i>Asignar Nuevo
        </a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle" id="tablaRelaciones" width="100%" cellspacing="0">
                <thead class="table-light">
                    <tr>
                        <th>Producto</th>
                        <th>Proveedor</th>
                        <th>Códigos Externos</th> <th class="text-end">Precio Costo</th>
                        <th class="text-center">Stock Asig.</th>
                        <th class="text-center" style="width: 120px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@item.NombreProducto</td>
                            
                            <td>
                                <i class="bi bi-truck text-muted me-1"></i>@item.NombreProveedor
                            </td>

                            <td>
                                @if(item.CodigosBarraExternos != null && item.CodigosBarraExternos.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach(var codigo in item.CodigosBarraExternos)
                                        {
                                            <span class="font-monospace small badge bg-light text-dark border" 
                                                  style="cursor: default;" title="Código Proveedor">
                                                @codigo
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small fst-italic">Sin códigos</span>
                                }
                            </td>

                            <td class="text-end fw-bold text-success">
                                $@item.Precio.ToString("N2")
                            </td>

                            <td class="text-center">
                                @if (item.StockAsignado > 0)
                                {
                                    <span class="badge bg-info text-dark rounded-pill">@item.StockAsignado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill">0</span>
                                }
                            </td>

                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" 
                                       asp-route-idProducto="@item.IdProducto" 
                                       asp-route-idProveedor="@item.IdProveedor"
                                       class="btn btn-warning btn-sm text-white" 
                                       title="Editar Precio/Stock">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    
                                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de eliminar esta relación?');">
                                        <input type="hidden" name="idProducto" value="@item.IdProducto" />
                                        <input type="hidden" name="idProveedor" value="@item.IdProveedor" />
                                        <button type="submit" class="btn btn-danger btn-sm rounded-0 rounded-end" title="Eliminar Relación">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#tablaRelaciones').DataTable({
                language: { url: "//cdn.datatables.net/plug-ins/1.13.7/i18n/es-ES.json" },
                order: [[0, 'asc']],
                pageLength: 10,
                columnDefs: [
                    { orderable: false, targets: [5] }, 
                    { className: "text-end", targets: [3] },
                    { className: "text-center", targets: [4, 5] }
                ],
                dom: "<'row'<'col-sm-12 col-md-6'l><'col-sm-12 col-md-6'f>>" +
                     "<'row'<'col-sm-12'tr>>" +
                     "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>",
            });
        });
    </script>
    <style>
        .zoom-hover { transition: transform 0.2s; }
        .zoom-hover:hover { transform: scale(1.03); cursor: default; }
    </style>
}