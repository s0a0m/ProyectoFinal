@using src.Presentation.ViewModels.CuentaCorrienteVM
@model CuentaCorrienteVM

@{
    var facturasPendientes = Model.Facturas.Count(f => !f.Pagada);
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 fw-bold text-primary mb-1">@Model.RazonSocial</h2>
            <p class="text-muted mb-0">Titular: @Model.PersonaResponsable · CUIT: @Model.Cuit</p>
        </div>
        <a asp-controller="Proveedor" asp-action="ListarProveedores" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Proveedores
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body py-3 px-3">
                    <small class="text-uppercase text-muted fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Saldo actual</small>
                    <p class="fs-4 fw-bold mb-0 mt-1 @(Model.SaldoTotal > 0 ? "text-danger" : "text-success")">$@Model.SaldoTotal.ToString("N2")</p>
                    <small class="text-muted">@facturasPendientes factura(s) pendiente(s)</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 bg-light h-100">
                <div class="card-body py-3 px-3">
                    <small class="text-uppercase text-muted fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Total facturado</small>
                    <p class="fs-5 fw-bold mb-0 mt-1 text-dark">$@Model.TotalFacturado.ToString("N2")</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 bg-light h-100">
                <div class="card-body py-3 px-3">
                    <small class="text-uppercase text-muted fw-bold" style="font-size: 0.65rem; letter-spacing: 0.5px;">Total pagado</small>
                    <p class="fs-5 fw-bold mb-0 mt-1 text-success">$@Model.TotalPagado.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-3">
        <a asp-controller="OrdenPago" asp-action="Index" asp-route-idProveedor="@Model.IdProveedor" class="btn btn-sm btn-primary">
            <i class="bi bi-cash-coin me-1"></i> Gestionar pagos
        </a>
    </div>

    @if (!Model.Facturas.Any())
    {
        <div class="card border-0 shadow-sm"><div class="card-body text-center py-5"><i class="bi bi-inbox text-muted" style="font-size: 2.5rem;"></i><p class="text-muted mt-3 mb-0">No hay facturas registradas.</p></div></div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="accordion accordion-flush" id="accordionCC">
                    @foreach (var factura in Model.Facturas)
                    {
                        var collapseId = $"cc-{factura.IdFactura}";
                        var tieneDocumentos = factura.Notas.Any() || factura.Pagos.Any();
                        var estadoClass = factura.Estado switch { "Pagada" => "bg-success bg-opacity-10 text-success", "Parcial" => "bg-warning bg-opacity-10 text-warning", _ => "bg-danger bg-opacity-10 text-danger" };
                        var saldoClass = factura.Pagada ? "text-success" : "text-danger";

                        <div class="accordion-item border-0 @(factura != Model.Facturas.Last() ? "border-bottom" : "")">
                            <div class="accordion-header">
                                <div class="d-flex align-items-center py-3 px-3">
                                    <button class="btn btn-sm btn-link text-muted p-0 me-2 @(tieneDocumentos ? "" : "invisible") collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                                        <i class="bi bi-chevron-right toggle-icon"></i>
                                    </button>
                                    <div class="row w-100 align-items-center gx-2">
                                        <div class="col-md-3">
                                            <span class="fw-bold text-dark">@factura.NumeroFactura</span><br>
                                            <small class="text-muted">@factura.FechaEmision.ToString("dd/MM/yyyy")</small>
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <small class="text-muted d-block small-label">Total</small>
                                            <span class="fw-bold">$@factura.TotalFacturado.ToString("N2")</span>
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <small class="text-muted d-block small-label">Saldo</small>
                                            <span class="fw-bold @saldoClass">$@factura.Saldo.ToString("N2")</span>
                                        </div>
                                        <div class="col-md-2 text-center">
                                            <span class="badge @estadoClass rounded-pill">@factura.Estado</span>
                                        </div>
                                        <div class="col-md-3 text-end">
                                            <div class="btn-group btn-group-sm">
                                                @if (!factura.Pagada) {
                                                    <button type="button" class="btn btn-outline-info" onclick="abrirModalNota(@factura.IdFactura, 'NC', '@factura.NumeroFactura', @factura.Saldo.ToString(System.Globalization.CultureInfo.InvariantCulture))">NC</button>
                                                }
                                                <button type="button" class="btn btn-outline-warning" onclick="abrirModalNota(@factura.IdFactura, 'ND', '@factura.NumeroFactura', @factura.Saldo.ToString(System.Globalization.CultureInfo.InvariantCulture))">ND</button>
                                                <a asp-controller="Factura" asp-action="Details" asp-route-id="@factura.IdFactura" class="btn btn-outline-secondary"><i class="bi bi-eye"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="@collapseId" class="accordion-collapse collapse" data-bs-parent="#accordionCC">
                                <div class="px-5 pb-3">
                                    @foreach (var nota in factura.Notas) {
                                        <div class="d-flex align-items-center py-2 border-bottom">
                                            <span class="badge @(nota.Tipo == "NC" ? "bg-info" : "bg-warning") me-3">@nota.Tipo</span>
                                            <span class="fw-bold me-3">@nota.Numero</span>
                                            <span class="text-muted small">@nota.Motivo</span>
                                            <span class="ms-auto fw-bold @(nota.Tipo == "NC" ? "text-info" : "text-danger")">@(nota.Tipo == "NC" ? "-" : "+")$@nota.Total.ToString("N2")</span>
                                            <button class="btn btn-sm btn-link text-muted ms-2" onclick="verDetalleComprobante(@nota.IdComprobante)"><i class="bi bi-eye"></i></button>
                                        </div>
                                    }
                                    @foreach (var pago in factura.Pagos) {
                                        <div class="d-flex align-items-center py-2 border-bottom">
                                            <span class="badge bg-success me-3">OP</span>
                                            <span class="fw-bold me-3">@pago.Numero</span>
                                            <span class="text-muted small">@pago.FechaPago?.ToString("dd/MM/yyyy")</span>
                                            <span class="ms-auto fw-bold text-success">-$@pago.MontoAplicado.ToString("N2")</span>
                                            <button class="btn btn-sm btn-link text-muted ms-2" onclick="verDetalleOrden(@pago.IdOrdenPago)"><i class="bi bi-eye"></i></button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="modalCrearNota" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalNotaTitulo">Emitir nota</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="notaIdFactura"><input type="hidden" id="notaTipo">
                <div class="mb-3">
                    <label class="form-label fw-bold">Factura: <span id="modalNotaFacturaRef" class="text-primary"></span></label>
                    <div id="modalNotaSaldoWrap" class="float-end">Saldo: <span id="modalNotaSaldo" class="text-danger"></span></div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Monto</label>
                    <input type="number" class="form-control" id="notaTotal" step="0.01">
                </div>
                <div class="mb-3">
                    <label class="form-label">Motivo</label>
                    <select class="form-select" id="notaMotivo"></select>
                </div>
                <div id="notaAlerta" class="alert d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnEmitirNota" onclick="emitirNota()">Emitir</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetalleOrden" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content" id="contenidoModalOrden"></div></div>
</div>
<div class="modal fade" id="modalDetalleComprobante" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content" id="contenidoModalComprobante"></div></div>
</div>

<style> .small-label { font-size: 0.65rem; text-transform: uppercase; } .toggle-icon { transition: transform 0.2s; } .collapsed .toggle-icon { transform: rotate(-90deg); } </style>

@section Scripts {
    <script>
        const motivosNC = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MotivosNC));
        const motivosND = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MotivosND));

        function abrirModalNota(id, tipo, num, saldo) {
            document.getElementById('notaIdFactura').value = id;
            document.getElementById('notaTipo').value = tipo;
            document.getElementById('modalNotaFacturaRef').innerText = num;
            const select = document.getElementById('notaMotivo');
            select.innerHTML = '<option value="">Seleccione...</option>';
            
            if (tipo === 'NC') {
                document.getElementById('modalNotaTitulo').innerText = 'Emitir Nota de Crédito';
                document.getElementById('modalNotaSaldo').innerText = '$' + saldo.toFixed(2);
                motivosNC.forEach(m => select.innerHTML += `<option value="${m.IdMotivo}">${m.Descripcion}</option>`);
            } else {
                document.getElementById('modalNotaTitulo').innerText = 'Emitir Nota de Débito';
                document.getElementById('modalNotaSaldoWrap').classList.add('d-none');
                motivosND.forEach(m => select.innerHTML += `<option value="${m.IdMotivo}">${m.Descripcion}</option>`);
            }
            new bootstrap.Modal(document.getElementById('modalCrearNota')).show();
        }

        function emitirNota() {
            const payload = {
                idFactura: parseInt(document.getElementById('notaIdFactura').value),
                tipoComprobante: document.getElementById('notaTipo').value,
                total: parseFloat(document.getElementById('notaTotal').value),
                idMotivo: parseInt(document.getElementById('notaMotivo').value)
            };
            $.ajax({
                url: '/Comprobantes/notas',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: () => location.reload(),
                error: (xhr) => alert(xhr.responseJSON?.error || 'Error')
            });
        }

        function verDetalleOrden(id) {
            $.get('/OrdenesPago/ObtenerDetalleModal/' + id, data => {
                document.getElementById('contenidoModalOrden').innerHTML = data;
                new bootstrap.Modal(document.getElementById('modalDetalleOrden')).show();
            });
        }

        function verDetalleComprobante(id) {
            $.get('/Comprobantes/notas/detalle/' + id, data => {
                // Aquí podrías armar un HTML simple o recibirlo del server
                alert("Detalle Comprobante: " + data.numero + "\nTotal: " + data.total);
            });
        }
    </script>
}
