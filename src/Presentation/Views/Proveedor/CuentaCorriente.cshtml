@using src.Presentation.ViewModels.CuentaCorrienteVM
@model CuentaCorrienteVM

<div class="container-fluid py-4">
    
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h2 class="mb-1 fw-bold text-primary">@Model.RazonSocial</h2>
                    <p class="text-muted mb-0">Titular: @Model.PersonaResponsable | CUIT: @Model.Cuit</p>
                </div>
                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <div class="d-flex justify-content-md-end align-items-center gap-3">
                        <div class="text-end">
                            <small class="text-uppercase text-muted fw-bold" style="font-size: 0.75rem;">Saldo Total</small>
                            <h3 class="mb-0 fw-bold @(Model.SaldoTotal > 0 ? "text-danger" : "text-success")">
                                $@Model.SaldoTotal.ToString("N2")
                            </h3>
                        </div>
                        
                        <div class="btn-group">
                            <a asp-controller="DocumentoAsociado" asp-action="Index" asp-route-idProveedor="@Model.IdProveedor" class="btn btn-primary">
                                <i class="bi bi-cash-coin me-2"></i>Gestion Pagos
                            </a>
                            <button class="btn btn-secondary" disabled title="Próximamente">
                                <i class="bi bi-receipt me-2"></i>Gestion notas C/D
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <table id="tablaCuentaCorriente" class="table table-hover align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Número</th>
                        <th class="text-end">Importe</th>
                        <th class="text-end">Saldo (Fac)</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Movimientos)
                    {
                        // Si es Factura, fila gris sutil (table-active o custom style)
                        <tr class="@(item.EsFactura ? "table-active" : "")">
                            
                            <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                            
                            <td>
                                @if(item.EsFactura) { <span class="badge bg-primary bg-opacity-10 text-primary">Factura</span> }
                                else if(item.EsOrdenPago) { <span class="badge bg-success bg-opacity-10 text-success">Orden Pago</span> }
                                else { <span class="badge bg-secondary bg-opacity-10 text-secondary">@item.TipoMovimiento</span> }
                            </td>
                            
                            <td class="fw-bold">@item.NumeroComprobante</td>
                            
                            <td class="text-end">$@item.MontoTotal.ToString("N2")</td>
                            
                            <td class="text-end">
                                @if (item.EsFactura)
                                {
                                    <span class="@(item.SaldoPendiente > 0 ? "text-danger fw-bold" : "text-success")">
                                        $@item.SaldoPendiente?.ToString("N2")
                                    </span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>

                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    
                                    @if (item.EsFactura)
                                    {
                                        <a asp-controller="Factura" asp-action="Details" asp-route-id="@item.IdReferencia" 
                                           class="btn btn-outline-secondary" title="Ver Detalle">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-controller="Factura" asp-action="DocumentosAsociados" asp-route-id="@item.IdReferencia" class="btn btn-sm btn-outline-info" title="Ver Pagos y Notas">
                                            <i class="bi bi-folder2-open"></i>
                                        </a>


                                        @if (item.PuedeEditar)
                                        {
                                            <a asp-controller="Facturas" asp-action="Editar" asp-route-id="@item.IdReferencia" 
                                               class="btn btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }

                                    }
                                    else if (item.EsOrdenPago)
                                    {
                                        <button type="button" 
                                                class="btn btn-outline-secondary" 
                                                title="Ver Detalle"
                                                onclick="verDetalleOrden(@item.IdReferencia)">
                                            <i class="bi bi-eye"></i>
                                        </button>

                                        @if (item.PuedeEditar)
                                        {
                                            <a asp-controller="OrdenesPago" asp-action="Editar" asp-route-id="@item.IdReferencia" 
                                               class="btn btn-outline-primary" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" 
                                                    onclick="eliminarOrden(@item.IdReferencia)" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    }
                                    else if (item.EsComprobante)
                                    {
                                        <span class="btn btn-outline-secondary disabled" title="Proximamente">
                                             <i class="bi bi-eye"></i>
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalTrazabilidad" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Documentos Asociados</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contenidoTrazabilidad">
                <div class="text-center"><div class="spinner-border text-primary"></div></div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetalleOrden" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" id="contenidoModalOrden">
            <div class="modal-body text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Inicializar DataTables
            $('#tablaCuentaCorriente').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json"
                },
                "order": [[ 0, "desc" ]], // Asegurar orden visual por fecha
                "pageLength": 25
            });
        });

        // Función para llamar al GetByFacturaId (que hicimos antes) y mostrarlo en Modal
        function verTrazabilidad(idFactura) {
            $('#modalTrazabilidad').modal('show');
            // Asumo que tienes una ruta /Facturas/GetDocumentosAsociados o similar que devuelve una PartialView
            // Si devuelve JSON, habría que dibujar el HTML aquí con JS.
            // Por simplicidad, asumiré que puedes crear una acción que devuelva PartialView.
            
            // Ejemplo de llamada:
            /*
            $.get('/Facturas/GetTrazabilidadPartial/' + idFactura, function(data) {
                $('#contenidoTrazabilidad').html(data);
            });
            */
            // Si el método devuelve JSON (el DTO que hicimos la otra vez), tendrías que iterar y construir la tabla aquí en JS.
        }
        
        function verDetalleOrden(idOrden) {
            // 1. Mostrar el modal (mostrará el spinner por defecto)
            var myModal = new bootstrap.Modal(document.getElementById('modalDetalleOrden'));
            myModal.show();

            // 2. Cargar contenido vía AJAX
            $.get('/DocumentoAsociado/ObtenerDetalleModal/' + idOrden)
                .done(function (data) {
                    // Reemplazar el contenido del modal con la vista parcial
                    $('#contenidoModalOrden').html(data);
                })
                .fail(function () {
                    $('#contenidoModalOrden').html(
                        '<div class="modal-header"><h5 class="modal-title">Error</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>' +
                        '<div class="modal-body text-danger">No se pudo cargar el detalle de la orden.</div>'
                    );
                });
            
            // Limpiar el contenido al cerrar para que la próxima vez se vea el spinner de nuevo
            document.getElementById('modalDetalleOrden').addEventListener('hidden.bs.modal', function () {
                $('#contenidoModalOrden').html('<div class="modal-body text-center py-5"><div class="spinner-border text-primary"></div></div>');
            });
        }


        function eliminarOrden(id) {
            if(confirm('¿Está seguro de eliminar esta Orden de Pago?')) {
                // Llamada al form de eliminación o fetch API
                 window.location.href = '/OrdenesPago/Eliminar/' + id;
            }
        }
    </script>
}