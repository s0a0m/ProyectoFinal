@using src.Presentation.ViewModels.ProveedorVM
@model IEnumerable<ListarProveedorViewModel>

@{
    ViewData["Title"] = "Gestión de Proveedores";
    var hayProveedores = Model.Any();
    bool tienePermisoABM = LayoutService.TienePermiso("P05_ABM_PROVEEDORES"); 
}

@if (TempData["realizado"] != null)
{
    <div class="alert alert-success alert-dismissible fade show container mt-3 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["realizado"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show container mt-3 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container py-4">
    
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
        <h2 class="fw-bold text-primary m-0"><i class="bi bi-people-fill me-2"></i>@ViewData["Title"]</h2>
        
        @if (tienePermisoABM)
        {
            <a asp-controller="Proveedor" asp-action="CrearProveedor" class="btn btn-success shadow-sm">
                <i class="bi bi-plus-lg me-1"></i>Nuevo Proveedor
            </a>
        }
    </div>

    @* Tarjeta de búsqueda y filtros *@
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control border-start-0 ps-0" 
                               placeholder="Buscar por Razón Social o CUIT...">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="btn-group w-100" role="group" aria-label="Filtro de estado">
                        <input type="radio" class="btn-check" name="btnradio" id="btnActivos" autocomplete="off" checked onchange="filtrarProveedores('activo')">
                        <label class="btn btn-outline-primary" for="btnActivos">Activos</label>

                        <input type="radio" class="btn-check" name="btnradio" id="btnInactivos" autocomplete="off" onchange="filtrarProveedores('inactivo')">
                        <label class="btn btn-outline-secondary" for="btnInactivos">Inactivos</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!hayProveedores)
    {
        <div class="alert alert-light text-center p-5 border rounded bg-light">
            <i class="bi bi-inbox display-1 text-muted mb-3"></i>
            <p class="h5 text-muted">No hay proveedores registrados en el sistema.</p>
        </div>
    }
    else
    {
        <div class="row g-4" id="contenedorTarjetas">
            @foreach (var pr in Model)
            {
                <div class="col-12 col-md-6 col-lg-4 col-xl-3 tarjeta-proveedor" 
                     data-estado="@(pr.Activo ? "activo" : "inactivo")"
                     data-razon="@pr.RazonSocial.ToLower()"
                     data-cuit="@pr.Cuit">
                    
                    <div class="card h-100 border-0 shadow-sm hover-effect @(pr.Activo ? "" : "bg-light opacity-75")">
                        <div class="card-header bg-transparent border-0 d-flex justify-content-between pt-3">
                            @if(pr.Activo)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3">Inactivo</span>
                            }

                            <div class="dropdown">
                            <button class="btn btn-link text-dark p-0 text-decoration-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-three-dots-vertical"></i> </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center gap-2" 
                                    asp-controller="Proveedor" 
                                    asp-action="CuentaCorriente" 
                                    asp-route-id="@pr.IdProveedor">
                                        <i class="bi bi-card-list"></i> Ver Cuenta Corriente
                                    </a>
                                </li>
                                </ul>
                        </div>

                           
                        </div>

                        <div class="card-body text-center pt-0">
                            <div class="mb-3">
                                <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle" style="width: 64px; height: 64px;">
                                    <i class="bi bi-building fs-2"></i>
                                </div>
                            </div>
                            
                            <h5 class="card-title fw-bold text-truncate" title="@pr.RazonSocial">@pr.RazonSocial</h5>
                            <p class="text-muted small mb-1"><i class="bi bi-postcard me-1"></i>@pr.Cuit</p>
                            <p class="text-muted small mb-3"><i class="bi bi-person me-1"></i>@pr.PersonaResponsable</p>
                            
                            <div class="bg-light rounded p-2 mb-2">
                                <small class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Saldo Actual</small>
                                <div class="fw-bold @(pr.SaldoActual > 0 ? "text-danger" : "text-success")">
                                    $@pr.SaldoActual.ToString("N2")
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-transparent border-0 pb-3 px-3">
                            <div class="d-grid gap-2">
                                @* 2. BOTÓN VER DETALLE (Visible para todos) *@
                                <a asp-controller="Proveedor" asp-action="VerProveedor" asp-route-idProv="@pr.IdProveedor" 
                                   class="btn btn-info btn-sm text-white">
                                    <i class="bi bi-eye me-1"></i>Ver Detalle
                                </a>

                                
                                @if (tienePermisoABM)
                                {
                                    @if (pr.Activo)
                                    {
                                        <a asp-controller="Proveedor" asp-action="ActualizarProveedor" asp-route-idProv="@pr.IdProveedor" 
                                           class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-pencil me-1"></i>Editar
                                        </a>
                                        
                                        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalEliminar-@pr.IdProveedor">
                                            <i class="bi bi-trash me-1"></i>Desactivar
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-controller="Proveedor" asp-action="ReactivarProveedor" method="post" 
                                              onsubmit="return confirm('¿Desea reactivar este proveedor?');">
                                            <input type="hidden" name="idProv" value="@pr.IdProveedor" />
                                            <button type="submit" class="btn btn-success btn-sm w-100 text-white">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i>Reactivar
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    @* El Modal también debe estar protegido por el permiso para no renderizar HTML basura *@
                    @if (tienePermisoABM && pr.Activo)
                    {
                        <div class="modal fade" id="modalEliminar-@pr.IdProveedor" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header border-0">
                                        <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Desactivar Proveedor</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-center">
                                        <p class="text-muted mb-1">¿Está seguro que desea desactivar a <strong>@pr.RazonSocial</strong>?</p>
                                        <p class="small text-danger fw-bold bg-danger bg-opacity-10 p-2 rounded">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Esta acción ocultará también todos los productos asociados a este proveedor.
                                        </p>
                                    </div>
                                    <div class="modal-footer border-0 justify-content-center">
                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                                        <form asp-controller="Proveedor" asp-action="EliminarProveedor" method="post">
                                            <input type="hidden" name="idProv" value="@pr.IdProveedor" />
                                            <button type="submit" class="btn btn-danger px-4">Sí, Desactivar</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        
        <div id="mensajeVacioFiltro" class="alert alert-info text-center mt-4" style="display: none;">
            No hay proveedores en este estado.
        </div>
    }
</div>

@section Scripts {
    <script>
        let estadoActual = 'activo';

        function filtrarProveedores(estado) {
            estadoActual = estado;
            aplicarFiltros();
        }

        function aplicarFiltros() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const tarjetas = document.querySelectorAll('.tarjeta-proveedor');
            let visibles = 0;

            tarjetas.forEach(card => {
                const estado = card.getAttribute('data-estado');
                const razon = card.getAttribute('data-razon');
                const cuit = card.getAttribute('data-cuit');
                
                const coincideEstado = estado === estadoActual;
                const coincideBusqueda = searchTerm === '' || 
                                        razon.includes(searchTerm) || 
                                        cuit.includes(searchTerm);

                if (coincideEstado && coincideBusqueda) {
                    card.classList.remove('d-none');
                    visibles++;
                } else {
                    card.classList.add('d-none');
                }
            });

            const msg = document.getElementById('mensajeVacioFiltro');
            if (msg) {
                msg.style.display = visibles === 0 ? 'block' : 'none';
                if(visibles === 0) {
                    msg.textContent = searchTerm !== '' 
                        ? "No se encontraron proveedores que coincidan con la búsqueda."
                        : (estadoActual === 'activo' ? "No tienes proveedores activos." : "No hay proveedores inactivos.");
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function() {
            filtrarProveedores('activo');
            
            // Búsqueda en tiempo real
            document.getElementById('searchInput').addEventListener('input', aplicarFiltros);
        });
    </script>

    <style>
        .hover-effect { transition: transform 0.2s ease-in-out, box-shadow 0.2s; }
        .hover-effect:hover { transform: translateY(-5px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
        #searchInput:focus { box-shadow: none; border-color: #dee2e6; }
    </style>
}
