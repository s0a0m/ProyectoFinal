<!-- Estilos adicionales -->
<style>
    .fw-bold.text-muted.small {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
    }
    .fs-6 {
        font-size: 1rem !important;
    }
    .border-bottom {
        border-color: #e9ecef !important;
    }
</style>
