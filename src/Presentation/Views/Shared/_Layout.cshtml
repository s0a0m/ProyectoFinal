<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - src</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/src.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">src</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li> 
                       
                      @if (LayoutService.EstaLogueado())
                        {
                            @if (LayoutService.TienePermiso("P02_VER_LISTA_USUARIOS"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Usuario" asp-action="ListarUsuarios">Usuarios</a>
                                </li>
                            }

                            @if (LayoutService.TienePermiso("P11_ABM_GRUPO_PERMISOS"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="GrupoPermisos" asp-action="ListarGrupos">Grupo de Permisos</a>
                                </li>
                            }

                            @if (LayoutService.TienePermiso("P04_VER_LISTA_PRODUCTOS"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Producto" asp-action="ListarProductos">Productos</a>
                                </li>
                            }
                            
                            @if (LayoutService.TienePermiso("P12_ABM_CLASIFICACION_PRODUCTOS"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Clasificacion" asp-action="IndexClasificacion">Categorías</a>
                                </li>
                            }

                            @if (LayoutService.TienePermiso("P06_VER_LISTA_PROVEEDORES"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Proveedor" asp-action="ListarProveedores">Proveedores</a>
                                </li>
                            }

                            @if (LayoutService.TienePermiso("P07_GESTION_COMPRAS"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="ProductoProveedor" asp-action="Index">Catálogo Proveedores</a>
                                </li>
                            }
                        }
                    </ul>
                
                    <ul class="navbar-nav">
                        @if (LayoutService.EstaLogueado() && LayoutService.TienePermiso("P07_GESTION_COMPRAS"))
                        {
                            @await Component.InvokeAsync("Carrito")
                        }
                         @if (LayoutService.EstaLogueado())
                         {
                             <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown">
                                    Hola, @LayoutService.ObtenerNombreUsuario()
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Acceso" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                                        </a>
                                    </li>
                                </ul>
                             </li>
                         }
                         else
                         {
                             <li class="nav-item">
                                <a class="nav-link text-primary fw-bold" asp-controller="Acceso" asp-action="Login">Iniciar Sesión</a>
                             </li>
                         }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - src - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        // Función global para agregar al carrito via AJAX
        function agregarAlCarrito(idProducto, idProveedor, cantidad = 1) {
            $.post('/Carrito/Agregar', { idProducto: idProducto, idProveedor: idProveedor, cantidad: cantidad })
                .done(function (response) {
                    // 1. Actualizar el numerito rojo
                    var badge = $("#cart-badge");
                    badge.text(response.totalItems);
                    
                    if(response.totalItems > 0) {
                        badge.show();
                    }

                })
                .fail(function (xhr) {
                    alert("Error al agregar: " + xhr.responseText);
                });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>