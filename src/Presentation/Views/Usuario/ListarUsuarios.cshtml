@using src.Models.Domain
@model IEnumerable<Usuario> // Expecting a collection of Usuario objects

@{
    ViewData["Title"] = "Listado de Usuarios Activos"; // Sets the page title
}

@if (TempData["realizado"] != null)
{
    <section class="container py-3">
        <div class="alert alert-success w-75 mx-auto alert-dismissible fade show" role="alert">
            <p class="text-center mb-0">@TempData["realizado"]</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </section>
}

<div class="container mt-4">
    <h1 class="text-center mb-4">@ViewData["Title"]</h1>

    <div class="d-flex justify-content-end mb-3">
        <a asp-controller="Usuario" asp-action="CrearUsuario" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Añadir Usuario
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            No hay usuarios activos registrados. ¡Añade uno nuevo!
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">Apellido</th>
                        <th scope="col">Correo Electrónico</th>
                        <th scope="col" class="text-center">Operaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>@usuario.Nombre</td>
                            <td>@usuario.Apellido</td>
                            <td>@usuario.Correo</td>
                            <td class="text-center">
                                <a asp-controller="Usuario" 
                                   asp-action="VerUsuario" 
                                   asp-route-idUser="@usuario.IdUsuario" 
                                   class="btn btn-info btn-sm me-1" 
                                   title="Ver Detalle">
                                   <i class="bi bi-eye"></i> </a>
                                <a asp-controller="Usuario" 
                                   asp-action="ActualizarUsuario" 
                                   asp-route-idUsuario="@usuario.IdUsuario" 
                                   class="btn btn-warning btn-sm me-1" 
                                   title="Actualizar">
                                   <i class="bi bi-pencil-square"></i> </a>
                                <a asp-controller="Usuario" 
                                   asp-action="EliminarUsuario" 
                                   asp-route-idUsuario="@usuario.IdUsuario" 
                                   class="btn btn-danger btn-sm" 
                                   title="Eliminar (Desactivar)" 
                                   onclick="return confirm('¿Está seguro que desea desactivar este usuario?');">
                                   <i class="bi bi-trash"></i> </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Add Bootstrap Icons CSS if you haven't already in your _Layout.cshtml *@
@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}

@* You might need additional CSS for fine-tuning styles *@