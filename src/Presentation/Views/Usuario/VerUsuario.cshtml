@using src.Models.Domain
@model Usuario

@{
    ViewData["Title"] = $"Detalle de Usuario: {Model.Nombre} {Model.Apellido}";
}

<div class="container mt-5">
    <div class="row">

        <div class="col-lg-4 mb-4 mb-lg-0">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <i class="bi bi-person-circle display-1 text-secondary mb-3"></i>

                    <h5 class="card-title mt-3 mb-4">Lista de Permisos</h5>

                    @if (Model.PermisosUsuario != null && Model.PermisosUsuario.Any())
                    {
                        <ul class="list-group list-group-flush text-start">
                            @foreach (var permiso in Model.PermisosUsuario)
                            {
                                <li class="list-group-item">
                                    <i class="bi bi-check-circle-fill text-success me-2"></i>
                                    @permiso.Nombre
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mt-3">
                            Este usuario no tiene permisos asignados.
                        </p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Información del Usuario</h5>
                    <a asp-controller="Usuario" asp-action="ActualizarUsuario" asp-route-idUsuario="@Model.IdUsuario"
                        class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil-square me-1"></i> Editar Perfil
                    </a>
                </div>
                <div class="card-body p-4">
                    <dl class="row">
                        <dt class="col-sm-4">Nombre</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>

                        <dt class="col-sm-4">Apellido</dt>
                        <dd class="col-sm-8">@Model.Apellido</dd>

                        <dt class="col-sm-4">Identificación</dt>
                        <dd class="col-sm-8">@Model.Identificacion</dd>

                        <dt class="col-sm-4">Correo Electrónico</dt>
                        <dd class="col-sm-8"><a href="mailto:@Model.Correo">@Model.Correo</a></dd>

                        <dt class="col-sm-4">Teléfono</dt>
                        <dd class="col-sm-8">@Model.Telefono</dd>

                        <dt class="col-sm-4">Estado</dt>
                        <dd class="col-sm-8">
                            @if (Model.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Inactivo</span>
                            }
                        </dd>

                    </dl>
                </div>
                <div class="card-footer bg-light text-end">
                    <a asp-controller="Usuario" asp-action="ListarUsuarios" class="btn btn-secondary btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Volver a la Lista
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        /* Optional: Add custom styles if needed */
        .display-1 {
            /* Increase icon size */
            font-size: 6rem;
        }

        .card-header h5 {
            margin-bottom: 0;
            /* Align header text vertically */
        }

        dl.row dt {
            font-weight: 600;
            /* Make definition terms slightly bolder */
        }
    </style>
}